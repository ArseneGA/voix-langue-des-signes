<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="passenger1">
  <sign_manual>
    <sign_manual>
      <handconfig handshape="finger2" mainbend="round" thumbpos="out"/>
      <handconfig extfidir="ur"/>
      <handconfig palmor="l"/>
      <location_bodyarm contact="close" location="shouldertop" side="right_at"/>
      <directedmotion direction="d"/>
    </sign_manual>
    <sign_manual>
      <handconfig handshape="pinch12" specialfingers="23"/>
      <handconfig extfidir="u"/>
      <handconfig palmor="d"/>
      <location_bodyarm location="shoulders"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger23spread" thumbpos="out"/>
      </tgt_motion>
      <directedmotion direction="r"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="pinch12" specialfingers="23"/>
      </tgt_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger23spread" thumbpos="out"/>
      </tgt_motion>
    </sign_manual>
  </sign_manual>
</hamgestural_sign>

</sigml>
