<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="ninety1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2345" thumbpos="across"/>
      <handconfig handshape="finger2345" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="d"/>
      <handconfig extfidir="u" palmor="d"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shoulders" side="right_at"/>
      <location_bodyarm location="shoulders" side="left_at"/>
    </split_location>
    <rpt_motion repetition="continue">
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2345" mainbend="hooked" thumbpos="across"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
