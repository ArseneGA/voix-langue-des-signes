<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="bad1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger23spread" thumbpos="across"/>
      <handconfig handshape="fist"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="dl"/>
      <handconfig extfidir="or" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shouldertop" side="right_at"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <tgt_motion>
      <par_motion>
        <directedmotion direction="ol"/>
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="ol" palmor="ul"/>
        </tgt_motion>
      </par_motion>
      <handconstellation contact="touch">
        <location_hand location="thumbside"/>
        <location_hand location="pinkyside"/>
      </handconstellation>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
