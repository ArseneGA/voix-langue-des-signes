<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="everyone1">
  <sign_manual>
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="dr"/>
    <location_bodyarm contact="close" location="chest" side="left_at"/>
    <par_motion>
      <directedmotion direction="r" size="big"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="ur" palmor="l"/>
        <location_bodyarm location="shouldertop" side="right_beside"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
