<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="trader1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" mainbend="hooked"/>
    <split_handconfig>
      <handconfig extfidir="l" palmor="l"/>
      <handconfig extfidir="o" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="chest" side="right_at"/>
      <location_bodyarm location="chest" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <split_motion>
        <par_motion>
          <directedmotion direction="o"/>
          <tgt_motion>
            <changeposture/>
            <handconfig extfidir="o" palmor="l"/>
          </tgt_motion>
        </par_motion>
        <par_motion>
          <directedmotion direction="i"/>
          <tgt_motion>
            <changeposture/>
            <handconfig extfidir="r" palmor="r"/>
          </tgt_motion>
        </par_motion>
      </split_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
