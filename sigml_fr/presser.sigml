<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="press1">
  <sign_manual both_hands="true" lr_symm="true" ud_symm="true">
    <handconfig handshape="flat" mainbend="hooked" thumbpos="across"/>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shoulders"/>
      <location_bodyarm location="stomach"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="d" size="small" slow="true"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
