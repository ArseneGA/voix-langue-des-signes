<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="narrate1">
  <sign_manual both_hands="true" lr_symm="true" oi_symm="true">
    <handconfig handshape="finger23spread" thumbpos="opposed"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <handconstellation contact="touch">
      <location_bodyarm location="shoulders"/>
    </handconstellation>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion curve="d" direction="r" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig bend2="bent" bend3="bent" handshape="pinch12" mainbend="bent"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
