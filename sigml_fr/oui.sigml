<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="yes1">
  <sign_manual>
    <handconfig handshape="pinch12open"/>
    <handconfig extfidir="u" second_extfidir="o"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="chest" side="right_at"/>
    <tgt_motion>
      <changeposture/>
      <handconfig extfidir="o"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
