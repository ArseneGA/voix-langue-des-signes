<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="performance1">
  <sign_manual>
    <handconfig handshape="finger23" second_handshape="finger23" second_mainbend="bent" second_thumbpos="out" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="close" location="chin"/>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <directedmotion direction="i"/>
        <handconstellation contact="touch"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
