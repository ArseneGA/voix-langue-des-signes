<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="greet1">
  <sign_manual>
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="lips">
      <location_hand digits="234" location="nail" side="palmar"/>
    </location_bodyarm>
    <directedmotion direction="do"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
