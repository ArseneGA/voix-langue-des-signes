<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="coat1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="fist"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="shoulders" side="right_at"/>
    <par_motion>
      <tgt_motion>
        <directedmotion curve="r" direction="dl"/>
        <handconstellation contact="touch">
          <location_bodyarm contact="touch" location="chest"/>
        </handconstellation>
      </tgt_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="ul" palmor="l"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
