<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="May1">
  <sign_manual>
    <handconfig handshape="finger2" mainbend="bent" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="nostrils"/>
    <tgt_motion slow="true">
      <changeposture/>
      <handconfig handshape="finger2" thumbpos="across"/>
      <handconfig extfidir="u" palmor="dl"/>
      <location_bodyarm contact="touch" location="cheek"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
