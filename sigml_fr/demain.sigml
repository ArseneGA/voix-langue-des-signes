<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="tomorrow1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="out"/>
    <handconfig extfidir="ui"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="cheek" side="right_beside"/>
    <tgt_motion>
      <changeposture/>
      <handconfig extfidir="o"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
