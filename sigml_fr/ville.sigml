<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="town1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="l"/>
    <handconstellation contact="touch">
      <location_bodyarm location="neck"/>
    </handconstellation>
    <par_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger23spread" thumbpos="across"/>
        <handconfig extfidir="u" palmor="dl"/>
      </tgt_motion>
      <directedmotion curve="l" direction="or" size="small"/>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
