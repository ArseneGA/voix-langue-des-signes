<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="ball1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="ceeall"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="l"/>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <directedmotion direction="l" size="small"/>
        <handconstellation contact="touch"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
