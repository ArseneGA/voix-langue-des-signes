<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="shoe1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" specialfingers="5" thumbpos="out"/>
    <handconfig extfidir="uo"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="chest"/>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <directedmotion direction="l" fast="true" size="small"/>
        <handconstellation contact="touch">
          <location_hand digits="3" location="midjoint" side="dorsal"/>
          <location_hand digits="3" location="midjoint" side="dorsal"/>
        </handconstellation>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
