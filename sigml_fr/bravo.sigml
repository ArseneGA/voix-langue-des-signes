<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="bravo1">
  <sign_manual both_hands="true" oi_symm="true" ud_symm="true">
    <handconfig handshape="finger2345" thumbpos="out"/>
    <split_handconfig>
      <handconfig extfidir="u" palmor="l"/>
      <handconfig extfidir="u" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="neck" side="right_at"/>
      <location_bodyarm location="neck" side="left_at"/>
    </split_location>
    <wristmotion motion="twisting" size="big"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
