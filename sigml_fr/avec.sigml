<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="with1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="fist" thumbpos="out"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="chest"/>
    <tgt_motion>
      <directedmotion direction="l"/>
      <location_hand contact="touch" digits="3" location="midjoint"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
