<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="oil1">
  <sign_manual>
    <handconfig handshape="finger2" specialfingers="5" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="r"/>
    <location_bodyarm location="shoulders" side="right_at"/>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="u" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
