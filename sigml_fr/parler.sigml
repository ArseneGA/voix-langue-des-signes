<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="speak1">
  <sign_manual>
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="touch" location="lips">
      <location_hand digits="2" location="tip"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="l" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
