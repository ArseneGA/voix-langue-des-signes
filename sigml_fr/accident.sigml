<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="accident1">
  <sign_manual both_hands="true" lr_symm="true">
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="across"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="l" palmor="l"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <location_bodyarm location="chest" side="right_at"/>
    <tgt_motion>
      <directedmotion direction="l" fast="true" size="small"/>
      <location_hand contact="touch" digits="3" location="base"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
