<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="box1">
  <sign_manual both_hands="true" lr_symm="true" oi_symm="true" ud_symm="true">
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_bodyarm location="chest"/>
      <location_bodyarm contact="close" location="chest"/>
    </split_location>
    <par_motion>
      <directedmotion direction="r" size="small"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="o"/>
        <location_bodyarm location="chest" side="right_at"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
