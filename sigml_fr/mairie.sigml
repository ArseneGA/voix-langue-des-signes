<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="town_hall1">
  <sign_manual>
    <handconfig handshape="ceeall"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="shoulders" side="left_at"/>
    <tgt_motion>
      <directedmotion curve="r" direction="dr" size="big" slow="true"/>
      <location_bodyarm contact="touch" location="stomach" side="right_at"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
