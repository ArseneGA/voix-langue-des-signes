<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="old1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="close" location="underchin"/>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <directedmotion direction="ui" size="small"/>
        <location_bodyarm contact="touch" location="underchin"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
