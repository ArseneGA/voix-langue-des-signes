<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="lonely1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="shoulders" side="left_at"/>
    <tgt_motion>
      <directedmotion direction="r"/>
      <location_bodyarm location="shoulders" side="right_at"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
