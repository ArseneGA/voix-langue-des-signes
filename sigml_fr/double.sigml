<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="double1">
  <sign_manual>
    <handconfig handshape="finger2" thumbpos="out"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="ul"/>
    <location_bodyarm location="shoulders"/>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="pinch12" mainbend="bent"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
