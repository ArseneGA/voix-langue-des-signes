<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="proud1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="dl"/>
    <handconfig palmor="dr"/>
    <location_bodyarm contact="touch" location="stomach">
      <location_hand digits="1" location="tip"/>
    </location_bodyarm>
    <par_motion>
      <directedmotion direction="ur" fast="true" size="big"/>
      <fingerplay/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="l" palmor="d"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
