<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="November1">
  <sign_manual>
    <handconfig handshape="finger23" thumbpos="across"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="chin" side="right_at"/>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="i" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
