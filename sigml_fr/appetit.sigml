<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="appetite1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist"/>
      <handconfig handshape="finger2345" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ul" palmor="d"/>
      <handconfig extfidir="dr" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="chest"/>
      <location_bodyarm location="stomach" second_location="chest" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <directedmotion direction="dr"/>
        <handconstellation contact="touch">
          <location_hand location="handback"/>
          <location_hand location="midjoint"/>
        </handconstellation>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
