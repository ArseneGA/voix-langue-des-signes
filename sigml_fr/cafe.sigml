<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="coffee1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2" specialfingers="5" thumbpos="out"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="o" palmor="l"/>
      <handconfig extfidir="o" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shoulders" second_location="chest"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <rpt_motion repetition="continue">
      <circularmotion axis="u" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
