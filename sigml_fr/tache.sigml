<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="stain1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="across"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="d"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="shoulders" side="right_at"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <par_motion>
      <directedmotion direction="d"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger23spread" thumbpos="out"/>
        <handconfig extfidir="ol" palmor="d"/>
        <handconstellation contact="touch">
          <location_hand digits="3" location="midjoint"/>
          <location_hand digits="4" location="midjoint" side="dorsal"/>
        </handconstellation>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
