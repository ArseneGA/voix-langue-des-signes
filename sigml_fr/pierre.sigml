<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="stone1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger23spread" mainbend="hooked" thumbpos="across"/>
      <handconfig handshape="finger23spread" mainbend="hooked" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ul" palmor="l"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="shoulders" second_location="chest" second_side="right_beside"/>
      <location_bodyarm contact="close" location="chest" second_location="chest" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <par_motion>
        <directedmotion curve="l" direction="d" fast="true"/>
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="d" palmor="d"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
