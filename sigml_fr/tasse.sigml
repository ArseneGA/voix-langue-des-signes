<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="cup1">
  <sign_manual>
    <handconfig handshape="pinch12open" mainbend="bent" second_handshape="pinch12open"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="shoulders"/>
    <tgt_motion>
      <changeposture/>
      <handconfig extfidir="u" palmor="l"/>
      <location_bodyarm contact="close" location="lips"/>
    </tgt_motion>
    <tgt_motion>
      <changeposture/>
      <handconfig extfidir="ol" palmor="l"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
