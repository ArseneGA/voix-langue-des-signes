<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="promise1">
  <sign_manual>
    <handconfig handshape="flat" thumbpos="out"/>
    <split_handconfig>
      <handconfig extfidir="o" palmor="d"/>
      <handconfig extfidir="or" palmor="u" second_extfidir="o"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="chest"/>
      <location_bodyarm location="chest" second_location="stomach"/>
    </split_location>
    <tgt_motion>
      <directedmotion direction="d"/>
      <location_hand contact="touch" location="palm"/>
    </tgt_motion>
    <par_motion>
      <directedmotion direction="ur" size="big"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="u" palmor="d"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
