<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="shout1">
  <sign_manual>
    <handconfig handshape="finger23spread" mainbend="hooked" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="lips"/>
    <directedmotion direction="or"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
