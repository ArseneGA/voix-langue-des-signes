<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="foot1">
  <sign_manual>
    <split_handconfig>
      <handconfig bend3="bent" handshape="finger2345" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="or" palmor="d"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand location="handback"/>
      <location_hand digits="3" location="nail" side="palmar"/>
    </handconstellation>
    <rpt_motion repetition="fromstart_several">
      <par_motion>
        <directedmotion direction="ir" fast="true"/>
        <tgt_motion>
          <changeposture/>
          <handconfig bend3="round" handshape="finger2345" thumbpos="out"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
