<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="give1">
  <sign_manual>
    <handconfig handshape="flat" mainbend="bent" thumbpos="opposed"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="u"/>
    <location_bodyarm location="chest" side="right_at"/>
    <directedmotion curve="u" curve_size="big" direction="o"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
