<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="factory1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="cee12"/>
    <handconfig extfidir="uo"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_hand location="tip"/>
      <location_bodyarm location="shoulders"/>
    </split_location>
    <directedmotion curve="u" direction="r"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
