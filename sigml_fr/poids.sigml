<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="weight1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="u"/>
    <handconstellation contact="touch">
      <location_bodyarm location="shoulders" second_location="chest"/>
    </handconstellation>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <directedmotion direction="d"/>
        <location_bodyarm location="chest" second_location="stomach"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
