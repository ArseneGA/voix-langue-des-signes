<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="quiet2">
  <sign_manual>
    <sign_manual>
      <handconfig handshape="finger2" thumbpos="across"/>
      <handconfig extfidir="u"/>
      <handconfig palmor="l"/>
      <location_bodyarm contact="touch" location="lips">
        <location_hand digits="2" location="nail" side="palmar"/>
      </location_bodyarm>
    </sign_manual>
    <sign_manual both_hands="true" lr_symm="true">
      <handconfig handshape="flat" thumbpos="opposed"/>
      <handconfig extfidir="ul"/>
      <handconfig palmor="d"/>
      <handconstellation contact="touch"/>
      <par_motion>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="flat" mainbend="bent" thumbpos="opposed"/>
          <handconfig extfidir="u" palmor="l"/>
        </tgt_motion>
        <directedmotion direction="r"/>
      </par_motion>
    </sign_manual>
  </sign_manual>
</hamgestural_sign>

</sigml>
