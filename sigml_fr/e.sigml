<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="f">
  <sign_manual>
    <!-- Pince fermée index-pouce (forme OK), les autres doigts levés -->
    <handconfig handshape="pinch12"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="chest"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
