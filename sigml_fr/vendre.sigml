<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="sell1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="pinchall" mainbend="bent"/>
    <handconfig extfidir="dl"/>
    <handconfig palmor="ul"/>
    <location_bodyarm location="chest"/>
    <par_motion>
      <directedmotion direction="uo"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="u" palmor="dl"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
