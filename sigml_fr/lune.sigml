<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="moon1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" specialfingers="5" thumbpos="out"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="d"/>
    <split_location>
      <location_bodyarm contact="touch" location="forehead">
        <location_hand digits="1" location="tip"/>
      </location_bodyarm>
      <location_bodyarm contact="touch" location="chin">
        <location_hand digits="1" location="tip"/>
      </location_bodyarm>
    </split_location>
  </sign_manual>
</hamgestural_sign>

</sigml>
