<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="suggest1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat" second_handshape="flat" second_mainbend="bent" second_thumbpos="out" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <split_location>
      <location_bodyarm contact="close" location="shoulders" side="right_at"/>
      <location_bodyarm location="shoulders"/>
    </split_location>
    <tgt_motion>
      <par_motion>
        <directedmotion direction="d" size="big"/>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="flat" thumbpos="out"/>
          <handconfig extfidir="o"/>
        </tgt_motion>
      </par_motion>
      <location_bodyarm location="chest"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
