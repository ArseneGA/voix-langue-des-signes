<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="annoy1">
  <sign_manual>
    <handconfig handshape="fist"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="ul"/>
    <location_bodyarm contact="touch" location="cheek" side="right_at">
      <location_hand digits="3" location="midjoint"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <seq_motion>
        <directedmotion direction="ol" size="small"/>
        <directedmotion direction="ir" size="small"/>
      </seq_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
