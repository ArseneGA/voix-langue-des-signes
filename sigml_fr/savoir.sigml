<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="know1">
  <sign_manual>
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="close" location="forehead" side="right_at"/>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <directedmotion direction="i"/>
        <location_bodyarm contact="touch" location="forehead" side="right_at">
          <location_hand digits="3" location="nail" side="palmar"/>
        </location_bodyarm>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
