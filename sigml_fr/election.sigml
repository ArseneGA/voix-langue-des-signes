<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="election1">
  <sign_manual>
    <split_handconfig>
      <handconfig bend2="bent" handshape="finger2345" thumbpos="opposed"/>
      <handconfig handshape="ceeall"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="o" palmor="d"/>
      <handconfig extfidir="or" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="close" location="thumbside"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <par_motion>
      <directedmotion direction="u"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="pinch12open"/>
        <handconfig extfidir="uo"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
