<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="arrange1">
  <sign_manual both_hands="true" lr_symm="true" oi_symm="true">
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="close" location="chest"/>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="d"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
