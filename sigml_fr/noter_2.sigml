<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="write_down1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat" mainbend="bent" thumbpos="across"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="uo" palmor="d"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="touch" location="palm">
        <location_hand digits="3" location="tip"/>
      </location_hand>
      <location_bodyarm location="shoulders" second_location="chest"/>
    </split_location>
    <rpt_motion repetition="continue">
      <directedmotion curve="u" curve_size="small" direction="or" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
