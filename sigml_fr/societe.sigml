<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="society1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat" thumbpos="out"/>
      <handconfig handshape="finger2" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="l" palmor="d"/>
      <handconfig extfidir="u" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="shoulders"/>
      <location_bodyarm location="chest" second_location="shoulders"/>
    </split_location>
    <par_motion>
      <circularmotion axis="u"/>
      <tgt_motion>
        <fingerplay/>
        <handconstellation contact="touch">
          <location_hand digits="2" location="nail" side="palmar"/>
          <location_hand digits="3" location="nail" side="palmar"/>
        </handconstellation>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
