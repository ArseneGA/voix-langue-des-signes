<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="umbrella1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2" mainbend="hooked"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="l"/>
      <handconfig extfidir="or" palmor="r"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand location="thumbside"/>
      <location_hand location="pinkyside"/>
      <location_bodyarm location="shoulders"/>
    </handconstellation>
    <par_motion>
      <directedmotion direction="u" second_direction="ur"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="u" second_extfidir="ul"/>
        <location_bodyarm contact="close" location="forehead"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
