<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="opportunity1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig bend2="round" handshape="finger2" thumbpos="out"/>
    <handconfig extfidir="uo"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="shoulders"/>
    <rpt_motion repetition="fromstart_several">
      <directedmotion direction="do" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
