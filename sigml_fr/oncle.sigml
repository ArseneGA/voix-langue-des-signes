<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="uncle1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="pinchall"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="shoulders"/>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="i" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
