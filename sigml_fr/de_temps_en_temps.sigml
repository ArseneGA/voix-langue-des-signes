<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="from_time_to_time1">
  <sign_manual both_hands="true">
    <split_handconfig>
      <handconfig handshape="pinch12open"/>
      <handconfig handshape="pinch12open"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="uo" palmor="l"/>
      <handconfig extfidir="uo" palmor="r"/>
    </split_handconfig>
    <location_bodyarm contact="close" location="chest" second_location="shoulders"/>
    <rpt_motion repetition="fromstart_several">
      <par_motion>
        <directedmotion direction="d" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="finger2345" thumbpos="out"/>
          <handconfig extfidir="o"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
