<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="forget1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="opposed"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="forehead" side="right_at"/>
    <par_motion>
      <directedmotion direction="ol"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="pinchall" mainbend="bent"/>
        <handconfig palmor="l"/>
        <location_bodyarm contact="close" location="cheek" side="left_at"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
