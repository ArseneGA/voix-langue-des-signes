<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="milk1">
  <sign_manual>
    <sign_manual>
      <split_handconfig>
        <handconfig handshape="finger2345" thumbpos="out"/>
        <handconfig handshape="finger2" thumbpos="across"/>
      </split_handconfig>
      <split_handconfig>
        <handconfig extfidir="ol" palmor="d"/>
        <handconfig extfidir="or" palmor="d"/>
      </split_handconfig>
      <split_location>
        <location_bodyarm location="shoulders" side="left_at"/>
        <location_bodyarm location="chest" side="left_at"/>
      </split_location>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="fist" thumbcontact="midjoint" thumbpos="across"/>
        <location_hand contact="touch" digits="2">
          <location_hand location="handback"/>
        </location_hand>
      </tgt_motion>
      <directedmotion direction="or"/>
    </sign_manual>
    <sign_manual>
      <split_handconfig>
        <handconfig handshape="finger2345" thumbpos="out"/>
        <handconfig handshape="finger2" thumbpos="across"/>
      </split_handconfig>
      <split_handconfig>
        <handconfig extfidir="ol" palmor="d"/>
        <handconfig extfidir="or" palmor="d"/>
      </split_handconfig>
      <split_location>
        <location_bodyarm location="shoulders" side="left_at"/>
        <location_bodyarm location="chest" side="left_at"/>
      </split_location>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="fist" thumbcontact="midjoint" thumbpos="across"/>
        <location_hand contact="touch" digits="2">
          <location_hand location="handback"/>
        </location_hand>
      </tgt_motion>
      <directedmotion direction="or"/>
    </sign_manual>
  </sign_manual>
</hamgestural_sign>

</sigml>
