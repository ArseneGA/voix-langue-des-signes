<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="how_many1">
  <sign_manual both_hands="true">
    <handconfig handshape="fist"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <rpt_motion repetition="continue">
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2345" thumbpos="out"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
