<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="head1">
  <sign_manual>
    <sign_manual>
      <handconfig handshape="finger2" thumbpos="across"/>
      <handconfig extfidir="ui"/>
      <handconfig palmor="d"/>
      <location_bodyarm location="forehead" second_location="head" second_side="right_at" side="right_beside"/>
      <circularmotion axis="i" start="u"/>
    </sign_manual>
    <sign_manual>
      <handconfig handshape="flat" mainbend="bent" thumbpos="out"/>
      <handconfig extfidir="u"/>
      <handconfig palmor="ul"/>
      <location_bodyarm contact="close" location="forehead" side="right_at"/>
      <rpt_motion repetition="fromstart">
        <tgt_motion>
          <directedmotion direction="i"/>
          <location_bodyarm contact="touch" location="forehead" side="right_at">
            <location_hand digits="3" location="nail" side="palmar"/>
          </location_bodyarm>
        </tgt_motion>
      </rpt_motion>
    </sign_manual>
  </sign_manual>
</hamgestural_sign>

</sigml>
