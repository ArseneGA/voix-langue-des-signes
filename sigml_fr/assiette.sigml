<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="plate1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat" mainbend="bent" second_handshape="flat" second_thumbpos="opposed" thumbpos="opposed"/>
    <handconfig extfidir="dl"/>
    <handconfig palmor="ul"/>
    <split_location>
      <location_hand contact="touch" digits="2" location="tip">
        <location_hand digits="2" location="tip"/>
      </location_hand>
      <location_bodyarm location="chest" side="left_at"/>
    </split_location>
    <par_motion>
      <directedmotion curve="r" direction="i"/>
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="ur"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
