<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="between1">
  <sign_manual>
    <handconfig handshape="flat" thumbpos="out"/>
    <split_handconfig>
      <handconfig extfidir="o" palmor="ul"/>
      <handconfig extfidir="r" palmor="u"/>
    </split_handconfig>
    <location_hand contact="touch" location="palm">
      <location_hand digits="5" location="midjoint"/>
    </location_hand>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="dl"/>
        <location_hand contact="touch" location="palm">
          <location_hand digits="5" location="midjoint"/>
        </location_hand>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
