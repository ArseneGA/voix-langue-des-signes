<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="depth1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2" thumbpos="across"/>
      <handconfig handshape="flat"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="dl" palmor="d"/>
      <handconfig extfidir="o" palmor="dr"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="shouldertop" side="right_at"/>
      <location_bodyarm location="chest" side="left_at"/>
    </split_location>
    <tgt_motion>
      <directedmotion direction="dl" size="big"/>
      <location_hand contact="close" location="palm"/>
    </tgt_motion>
    <directedmotion direction="dl"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
