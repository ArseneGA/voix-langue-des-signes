<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="bicycle1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="uo"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_bodyarm location="chest"/>
      <location_bodyarm contact="close" location="chest"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="o"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
