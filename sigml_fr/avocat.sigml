<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="lawyer1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="across"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="close" location="shoulders"/>
    <par_motion>
      <directedmotion direction="i"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="do" palmor="d"/>
        <location_bodyarm contact="touch" location="chest">
          <location_hand digits="2" location="side"/>
        </location_bodyarm>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
