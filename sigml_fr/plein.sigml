<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="full1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat" thumbpos="out"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="o" palmor="d"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <tgt_motion>
      <directedmotion direction="l" fast="true"/>
      <location_hand contact="touch" digits="1" location="nail" side="palmar">
        <location_hand location="palm"/>
      </location_hand>
    </tgt_motion>
    <directedmotion direction="l" fast="true"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
