<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="move2">
  <sign_manual both_hands="true">
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="u"/>
    <split_location>
      <location_bodyarm location="chest"/>
      <location_bodyarm location="chest" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion direction="r" slow="true"/>
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="or"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
