<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="lady1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="touch" location="shoulders" second_location="shoulders" side="left_at">
      <location_hand digits="1" location="tip"/>
    </location_bodyarm>
    <directedmotion direction="r"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
