<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="store1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat" mainbend="bent" thumbpos="opposed"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="close" location="shoulders"/>
    <directedmotion direction="d"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
