<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="ear1">
  <sign_manual>
    <handconfig handshape="cee12open" specialfingers="2"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="earlobe">
      <location_hand digits="1" location="nail" side="palmar"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="o" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
