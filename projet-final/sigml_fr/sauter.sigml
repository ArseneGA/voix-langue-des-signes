<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="jump1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger23spread" mainbend="hooked" second_handshape="finger23" second_thumbpos="across" thumbpos="across"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="r" palmor="d"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand location="handback"/>
      <location_hand digits="2" location="tip"/>
      <location_bodyarm contact="close" location="chest"/>
    </handconstellation>
    <par_motion>
      <directedmotion curve="u" direction="uo" size="big"/>
      <directedmotion direction="do"/>
      <tgt_motion>
        <changeposture/>
        <split_handconfig>
          <handconfig extfidir="o"/>
          <handconfig extfidir="r"/>
        </split_handconfig>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
