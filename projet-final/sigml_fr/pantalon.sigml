<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="trousers1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <handconfig extfidir="dl" second_extfidir="o"/>
    <handconfig palmor="dl" second_palmor="d"/>
    <location_bodyarm contact="close" location="stomach"/>
    <rpt_motion repetition="fromstart_several">
      <par_motion>
        <directedmotion direction="ui"/>
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="di" palmor="u"/>
          <location_bodyarm contact="touch" location="stomach">
            <location_hand digits="23" location="tip"/>
          </location_bodyarm>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
