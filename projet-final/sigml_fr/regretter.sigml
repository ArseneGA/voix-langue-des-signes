<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="regret1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="close" location="head" side="right_at"/>
    <par_motion>
      <directedmotion curve="l" direction="il"/>
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="u"/>
        <location_bodyarm contact="touch" location="forehead" side="right_at"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
