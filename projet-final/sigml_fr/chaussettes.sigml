<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="sock1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="pinch12open" mainbend="bent"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="close" location="chest"/>
    <par_motion>
      <directedmotion direction="ui"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="o" palmor="dl"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
