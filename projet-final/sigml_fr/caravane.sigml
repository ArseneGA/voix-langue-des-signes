<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="caravan1">
  <sign_manual both_hands="true">
    <handconfig handshape="finger2" mainbend="hooked" thumbpos="across"/>
    <split_handconfig>
      <handconfig extfidir="l" palmor="d"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="touch" digits="2" location="midjoint"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <directedmotion direction="r"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
