<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="we1">
  <sign_manual>
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="il"/>
    <handconfig palmor="dr"/>
    <location_bodyarm contact="close" location="chest" side="right_at"/>
    <par_motion>
      <directedmotion curve="r" direction="o" size="big"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="ol" palmor="d"/>
      </tgt_motion>
    </par_motion>
    <par_motion>
      <directedmotion curve="l" direction="i" size="big"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="il" palmor="dr"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
