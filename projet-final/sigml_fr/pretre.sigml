<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="priest1">
  <sign_manual>
    <handconfig handshape="ceeall"/>
    <handconfig extfidir="ul" second_extfidir="l"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="neck" second_location="shoulders">
      <location_hand digits="1" location="tip" second_digits="2" second_location="tip"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="d" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
