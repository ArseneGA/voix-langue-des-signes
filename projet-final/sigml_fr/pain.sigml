<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="bread1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat" mainbend="bent" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="l" palmor="dl"/>
      <handconfig extfidir="r" palmor="dr"/>
    </split_handconfig>
    <location_hand contact="touch" location="wristback">
      <location_hand digits="2" location="tip"/>
    </location_hand>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="l" palmor="dr"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
