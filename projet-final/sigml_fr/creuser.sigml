<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="dig1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="o" palmor="d"/>
      <handconfig extfidir="o" palmor="r"/>
    </split_handconfig>
    <handconstellation contact="close"/>
    <rpt_motion repetition="fromstart_several">
      <par_motion>
        <directedmotion curve="u" direction="do" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="flat" mainbend="hooked"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
