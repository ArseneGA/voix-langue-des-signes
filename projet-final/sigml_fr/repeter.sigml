<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="repeat1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2" thumbpos="across"/>
      <handconfig handshape="flat"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="ul"/>
      <handconfig extfidir="o" palmor="ur"/>
    </split_handconfig>
    <location_hand contact="touch" location="palm">
      <location_hand digits="2" location="tip"/>
    </location_hand>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="o" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
