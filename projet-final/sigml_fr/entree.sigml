<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="entrance1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat"/>
      <handconfig handshape="flat"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="l"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand location="thumbside"/>
      <location_hand location="pinkyside"/>
    </handconstellation>
    <par_motion>
      <directedmotion direction="u" size="small"/>
      <directedmotion curve="u" direction="o"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="o"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
