<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="grass1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="chest"/>
    <par_motion>
      <directedmotion direction="u"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="pinchall" mainbend="bent"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
