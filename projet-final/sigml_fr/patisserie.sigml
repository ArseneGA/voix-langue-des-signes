<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="patisserie1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="ul"/>
    <location_bodyarm contact="close" location="cheek" second_location="tongue" second_side="right_at"/>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <directedmotion direction="i"/>
        <location_bodyarm contact="touch" location="cheek" second_location="tongue" second_side="right_at">
          <location_hand digits="1" location="nail"/>
        </location_bodyarm>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
