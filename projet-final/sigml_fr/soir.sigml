<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="evening1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="d" palmor="d"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand location="handback"/>
      <location_hand location="palm"/>
    </handconstellation>
    <directedmotion direction="d" size="small"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
