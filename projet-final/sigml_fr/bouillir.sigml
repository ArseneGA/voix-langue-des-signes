<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="boil1">
  <sign_manual both_hands="true" lr_symm="true" oi_symm="true" ud_symm="true">
    <handconfig handshape="finger2345" mainbend="round"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="u"/>
    <split_location>
      <location_bodyarm contact="close" location="chest" side="right_at"/>
      <location_bodyarm location="stomach" second_location="chest" second_side="right_at" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <circularmotion axis="l"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
