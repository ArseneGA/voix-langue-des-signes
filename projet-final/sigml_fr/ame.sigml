<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="soul1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="close" location="shoulders" side="right_beside"/>
    <par_motion>
      <directedmotion curve="l" direction="ui" size="small"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="flat" mainbend="bent" thumbpos="opposed"/>
        <handconfig palmor="u"/>
        <location_bodyarm contact="close" location="headtop" side="right_at"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
