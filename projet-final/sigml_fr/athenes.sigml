<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="Athens1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2345" thumbpos="across"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="d" palmor="d"/>
      <handconfig extfidir="r" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shoulders"/>
      <location_bodyarm location="stomach"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <directedmotion direction="d"/>
        <location_hand contact="touch" location="palm">
          <location_hand digits="3" location="tip"/>
        </location_hand>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
