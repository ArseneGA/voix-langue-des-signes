<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="habit1">
  <sign_manual>
    <handconfig handshape="finger23" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="r"/>
    <location_bodyarm contact="touch" location="forehead" side="right_at">
      <location_hand digits="2" location="nail"/>
    </location_bodyarm>
    <tgt_motion>
      <changeposture/>
      <handconfig bend3="bent" handshape="finger23spread" thumbpos="across"/>
      <handconfig extfidir="u" palmor="l"/>
      <location_bodyarm contact="close" location="head" side="right_at"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
