<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="sound1">
  <sign_manual>
    <handconfig handshape="pinch12open" mainbend="bent"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="earlobe">
      <location_hand digits="1" location="nail" side="palmar"/>
    </location_bodyarm>
    <directedmotion direction="r" fast="true" size="small"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
