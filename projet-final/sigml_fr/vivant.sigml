<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="alive1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="ul"/>
    <location_bodyarm contact="touch" location="shoulders" second_location="shoulders" side="right_at">
      <location_hand digits="3" location="nail" side="palmar"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="l" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
