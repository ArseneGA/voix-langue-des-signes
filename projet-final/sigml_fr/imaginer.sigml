<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="imagine1">
  <sign_manual both_hands="true" lr_symm="true" outofphase="true">
    <handconfig handshape="finger2" specialfingers="5"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="forehead" side="right_at"/>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="l" slow="true"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
