<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="Europe1">
  <sign_manual>
    <handconfig handshape="finger2345" mainbend="hooked" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="shouldertop" side="right_at"/>
    <circularmotion axis="i" size="small" start="r"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
