<hamgestural_sign gloss="right3">
  <sign_manual>
    <handconfig handshape="flat" mainbend="bent" thumbpos="out"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="r"/>
    <location_bodyarm location="chest"/>
    <directedmotion direction="r"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
