<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="map1">
  <sign_manual both_hands="true" lr_symm="true" ud_symm="true">
    <handconfig handshape="finger2" thumbpos="across"/>
    <split_handconfig>
      <handconfig extfidir="l" palmor="r"/>
      <handconfig extfidir="u" palmor="d"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="head" side="right_at"/>
      <location_bodyarm location="chest" side="left_at"/>
    </split_location>
    <par_motion>
      <directedmotion direction="dl"/>
      <tgt_motion>
        <wristmotion motion="twisting"/>
        <location_hand contact="touch" digits="2" location="midjoint"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
