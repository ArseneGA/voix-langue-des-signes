<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="brief1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="shoulders"/>
    <directedmotion direction="l" fast="true" size="small"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
