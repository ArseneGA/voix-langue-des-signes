<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="fat1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" mainbend="round" thumbpos="out"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="l" second_palmor="dl"/>
    <location_bodyarm contact="close" location="chest"/>
    <directedmotion direction="or" fast="true"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
