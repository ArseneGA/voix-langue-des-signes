<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="Berlin1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <location_bodyarm location="forehead" side="right_beside"/>
    <par_motion>
      <directedmotion direction="r" size="small"/>
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="d"/>
      </tgt_motion>
    </par_motion>
    <tgt_motion>
      <directedmotion direction="i"/>
      <location_bodyarm location="forehead" side="right_beside"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
