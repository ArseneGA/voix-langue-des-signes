<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="have1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="close" location="shoulders" second_location="chest"/>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <directedmotion direction="i"/>
        <location_bodyarm contact="touch" location="shoulders" second_location="chest">
          <location_hand digits="1" location="nail"/>
        </location_bodyarm>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
