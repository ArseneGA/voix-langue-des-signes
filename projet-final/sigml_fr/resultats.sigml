<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="result1">
  <sign_manual>
    <handconfig handshape="pinch12open"/>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="l" second_extfidir="o"/>
      <handconfig extfidir="or" palmor="r" second_extfidir="o"/>
    </split_handconfig>
    <location_hand contact="touch" digits="1" location="tip"/>
    <directedmotion direction="r"/>
    <par_motion>
      <directedmotion direction="d"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2345" thumbpos="out"/>
        <handconfig extfidir="do" palmor="d"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
