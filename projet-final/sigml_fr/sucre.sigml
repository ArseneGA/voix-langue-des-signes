<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="sugar1">
  <sign_manual>
    <handconfig handshape="finger2" mainbend="round" second_handshape="finger2"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="touch" location="cheek" second_location="chin" second_side="right_at">
      <location_hand digits="2" location="tip"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="ul"/>
        <location_bodyarm contact="touch" location="cheek" second_location="chin" second_side="right_at">
          <location_hand digits="2" location="tip"/>
        </location_bodyarm>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
