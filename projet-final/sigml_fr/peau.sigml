<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="skin1">
  <sign_manual>
    <handconfig handshape="finger2" mainbend="hooked" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="cheek"/>
    <wristmotion motion="swinging"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
