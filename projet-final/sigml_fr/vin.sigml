<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="wine1">
  <sign_manual>
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l" second_palmor="ul"/>
    <location_bodyarm contact="close" location="cheek"/>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="l" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
