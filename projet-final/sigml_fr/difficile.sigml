<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="difficult1">
  <sign_manual>
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="close" location="forehead"/>
    <rpt_motion repetition="continue_several">
      <par_motion>
        <directedmotion direction="l" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig bend2="round" handshape="finger2" thumbpos="across"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
