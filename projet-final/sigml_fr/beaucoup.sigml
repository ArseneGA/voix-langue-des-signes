<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="many1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" thumbpos="opposed"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="close" location="chest"/>
    <rpt_motion repetition="continue_several">
      <par_motion>
        <directedmotion direction="r" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="pinchall" mainbend="bent" second_handshape="pinchall"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
