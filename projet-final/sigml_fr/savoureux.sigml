<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="tasty1">
  <sign_manual>
    <handconfig handshape="pinchall" second_handshape="pinchall" second_mainbend="bent"/>
    <handconfig extfidir="uo"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="close" location="chin">
      <location_hand digits="3" location="tip"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart_several">
      <circularmotion axis="u" size="small" start="r"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
