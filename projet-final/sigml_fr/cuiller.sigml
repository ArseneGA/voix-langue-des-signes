<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="spoon1">
  <sign_manual>
    <handconfig handshape="finger2" mainbend="hooked"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="neck" side="right_at"/>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion curve="d" direction="i"/>
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="il" palmor="ur"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
