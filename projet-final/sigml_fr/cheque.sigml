<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="cheque1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="cee12"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="l"/>
    <handconstellation contact="touch">
      <location_bodyarm location="chest"/>
    </handconstellation>
    <tgt_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="o" palmor="d"/>
      </tgt_motion>
      <handconstellation contact="close">
        <location_bodyarm location="stomach" second_location="chest"/>
      </handconstellation>
    </tgt_motion>
    <directedmotion direction="r"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
