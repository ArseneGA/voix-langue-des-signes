<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="declare1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger23" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="touch" location="chin">
      <location_hand digits="3" location="nail" side="palmar"/>
    </location_bodyarm>
    <par_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="o"/>
      </tgt_motion>
      <directedmotion direction="do"/>
      <directedmotion direction="or"/>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
