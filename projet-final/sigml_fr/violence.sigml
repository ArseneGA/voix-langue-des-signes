<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="violence1">
  <sign_manual both_hands="true" lr_symm="true" outofphase="true">
    <handconfig handshape="finger2" mainbend="round" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="touch" location="chin">
      <location_hand digits="2" location="midjoint"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart_several">
      <circularmotion axis="l" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
