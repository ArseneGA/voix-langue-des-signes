<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="choose1">
  <sign_manual>
    <handconfig handshape="cee12open" mainbend="bent"/>
    <handconfig extfidir="uo"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="chest" side="right_at"/>
    <par_motion>
      <directedmotion direction="ui"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="pinch12open" mainbend="bent"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
