<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="belong1">
  <sign_manual>
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="shoulders" side="right_at"/>
    <tgt_motion>
      <changeposture/>
      <handconfig extfidir="or" palmor="l"/>
      <location_bodyarm location="shoulders" side="right_beside"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
