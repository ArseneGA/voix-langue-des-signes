<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="international1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger23" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="r"/>
    <handconstellation contact="cross">
      <location_bodyarm contact="close" location="nose"/>
    </handconstellation>
    <directedmotion curve="r" direction="d" size="big"/>
    <par_motion>
      <directedmotion direction="dr" size="big"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="uo" palmor="d"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
