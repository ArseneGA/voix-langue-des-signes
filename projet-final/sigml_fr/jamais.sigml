<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="never1">
  <sign_manual>
    <handconfig handshape="finger2" specialfingers="5" thumbpos="out"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="d"/>
    <par_motion>
      <directedmotion direction="dr"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="o"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
