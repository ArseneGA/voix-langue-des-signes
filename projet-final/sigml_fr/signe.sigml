<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="sign1">
  <sign_manual both_hands="true" ud_symm="true">
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="ui" second_extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="shoulders"/>
    <circularmotion axis="r" clockplus="true"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
