<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="automatic1">
  <sign_manual>
    <handconfig handshape="pinch12open"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="shoulders" side="right_at"/>
    <rpt_motion repetition="fromstart_several" repetition_incrdecr="decreasing">
      <circularmotion axis="u" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
