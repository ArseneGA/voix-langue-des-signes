<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="throw_away1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="across"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="l" palmor="l"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <location_hand contact="touch" digits="1" location="side" side="right_at">
      <location_hand digits="5" location="side"/>
    </location_hand>
    <tgt_motion>
      <par_motion>
        <directedmotion direction="o" fast="true"/>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="finger2" thumbpos="across"/>
        </tgt_motion>
      </par_motion>
      <location_bodyarm location="shouldertop" side="left_at"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
