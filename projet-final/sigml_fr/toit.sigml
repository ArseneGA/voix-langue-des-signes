<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="roof1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="d"/>
    <split_location>
      <location_hand contact="touch" digits="3" location="tip">
        <location_hand digits="3" location="tip"/>
      </location_hand>
      <location_bodyarm contact="close" location="shouldertop" side="left_at"/>
    </split_location>
    <directedmotion direction="dr" size="small"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
