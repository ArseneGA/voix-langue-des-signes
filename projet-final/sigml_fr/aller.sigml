<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="go1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="do" second_extfidir="l"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="close" location="chest" side="right_at"/>
    <par_motion>
      <directedmotion curve="d" direction="u"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="u" palmor="ul" second_extfidir="l"/>
      </tgt_motion>
    </par_motion>
    <par_motion>
      <directedmotion direction="do"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="o"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
