<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="England1">
  <sign_manual>
    <handconfig handshape="finger2" mainbend="round" thumbpos="out"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="chin" side="left_at"/>
    <rpt_motion repetition="fromstart">
      <wristmotion motion="nodding"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
