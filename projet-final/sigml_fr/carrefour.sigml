<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="crossroad1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="across"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ul" palmor="r"/>
      <handconfig extfidir="ur" palmor="l"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="shouldertop" side="left_at"/>
      <location_bodyarm location="shouldertop"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <directedmotion direction="i" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
