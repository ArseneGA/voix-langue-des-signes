<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="thin2">
  <sign_manual>
    <handconfig handshape="finger2" specialfingers="5" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="head" side="right_at"/>
    <directedmotion direction="d" zigzag_size="small" zigzag_style="wavy"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
