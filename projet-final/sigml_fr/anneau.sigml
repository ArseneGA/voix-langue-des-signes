<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="ring1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="cee12open"/>
      <handconfig handshape="finger2345" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="or" palmor="d"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="touch" digits="3" location="tip">
        <location_hand digits="1" location="nail" side="palmar"/>
      </location_hand>
      <location_bodyarm location="chest"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="il" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
