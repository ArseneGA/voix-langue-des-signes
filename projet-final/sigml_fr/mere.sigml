<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="mother1">
  <sign_manual>
    <handconfig handshape="flat" thumbpos="across"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="close" location="stomach" side="right_at"/>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="o" fast="true"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
