<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="purpose1">
  <sign_manual>
    <handconfig handshape="finger2" second_handshape="finger2" second_mainbend="bent" second_thumbpos="across" thumbpos="across"/>
    <split_handconfig>
      <handconfig extfidir="u" palmor="dl"/>
      <handconfig extfidir="ur" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="cheek" side="right_at">
        <location_hand digits="2" location="tip"/>
      </location_bodyarm>
      <location_bodyarm location="shoulders" side="left_at"/>
    </split_location>
    <tgt_motion>
      <directedmotion curve="u" curve_size="small" direction="o"/>
      <location_hand contact="touch" digits="2" location="nail" side="palmar"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
