<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="disappointed1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig bend3="bent" handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="ul"/>
    <location_bodyarm contact="close" location="lips"/>
    <tgt_motion>
      <changeposture/>
      <handconfig handshape="finger2345" thumbpos="out"/>
      <handconfig extfidir="l" palmor="ul"/>
      <location_bodyarm location="chest"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
