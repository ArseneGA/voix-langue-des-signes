<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="visit1">
  <sign_manual both_hands="true">
    <split_handconfig>
      <handconfig handshape="finger23spread" second_handshape="finger23spread" second_thumbpos="opposed" thumbpos="across"/>
      <handconfig handshape="finger2345" mainbend="round" second_handshape="finger2345" second_thumbpos="out" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="d"/>
      <handconfig extfidir="r" palmor="d"/>
    </split_handconfig>
    <location_hand contact="touch" location="wristback">
      <location_hand location="thumbball"/>
    </location_hand>
    <par_motion>
      <rpt_motion repetition="continue_several">
        <directedmotion direction="r" size="small"/>
      </rpt_motion>
      <rpt_motion repetition="fromstart_several">
        <tgt_motion>
          <changeposture/>
          <split_handconfig>
            <handconfig extfidir="o" palmor="d"/>
            <handconfig/>
          </split_handconfig>
        </tgt_motion>
      </rpt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
