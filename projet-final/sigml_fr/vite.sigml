<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="fast1">
  <sign_manual>
    <handconfig handshape="flat" mainbend="bent" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="lips" second_location="underchin" second_side="right_at"/>
    <directedmotion direction="l" fast="true"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
