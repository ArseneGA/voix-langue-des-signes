<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="always1">
  <sign_manual>
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <location_bodyarm location="neck"/>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="u"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
