<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="salary1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="o" palmor="l"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand digits="3" location="midjoint" side="palmar"/>
      <location_hand location="pinkyside"/>
    </handconstellation>
    <par_motion>
      <directedmotion direction="il"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="fist" thumbpos="out"/>
        <handconfig extfidir="ol"/>
        <handconstellation contact="touch">
          <location_hand location="palm"/>
          <location_hand location="pinkyside"/>
        </handconstellation>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
