<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="month1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="out"/>
      <handconfig handshape="flat"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="d"/>
      <handconfig extfidir="u" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="touch" digits="3" location="nail" side="palmar">
        <location_hand digits="1" location="tip"/>
      </location_hand>
      <location_bodyarm contact="close" location="shoulders"/>
    </split_location>
    <tgt_motion>
      <directedmotion direction="d"/>
      <location_hand contact="touch" location="palm">
        <location_hand digits="1" location="tip"/>
      </location_hand>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
