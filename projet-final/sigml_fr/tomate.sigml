<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="tomato1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2345" mainbend="round" second_handshape="finger2345" second_thumbpos="out" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="d"/>
      <handconfig extfidir="uo" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shoulders" side="right_at"/>
      <location_bodyarm location="shoulders"/>
    </split_location>
    <par_motion>
      <directedmotion direction="l"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2345" mainbend="round" thumbpos="opposed"/>
        <handconfig extfidir="uo" palmor="l" second_extfidir="ol"/>
        <handconstellation contact="touch">
          <location_hand location="palm"/>
          <location_hand location="tip"/>
        </handconstellation>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
