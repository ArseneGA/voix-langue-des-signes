<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="basin1">
  <sign_manual>
    <sign_manual both_hands="true" lr_symm="true">
      <handconfig handshape="flat" mainbend="round" second_handshape="flat" second_mainbend="round" second_thumbpos="out" thumbpos="out"/>
      <handconfig extfidir="o"/>
      <handconfig palmor="u"/>
      <split_location>
        <location_bodyarm location="chest"/>
        <location_hand contact="touch" location="pinkyside">
          <location_hand location="pinkyside"/>
        </location_hand>
      </split_location>
      <par_motion>
        <directedmotion curve="d" direction="ur"/>
        <tgt_motion>
          <changeposture/>
          <handconfig palmor="l"/>
        </tgt_motion>
      </par_motion>
    </sign_manual>
    <sign_manual>
      <handconfig handshape="flat" mainbend="round" second_handshape="flat"/>
      <split_handconfig>
        <handconfig extfidir="u" palmor="d"/>
        <handconfig extfidir="r" palmor="r"/>
      </split_handconfig>
      <split_location>
        <location_hand contact="touch" location="palm">
          <location_hand location="palm"/>
        </location_hand>
        <location_bodyarm location="chest"/>
      </split_location>
      <par_motion>
        <directedmotion direction="u" size="small"/>
        <directedmotion direction="do" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="do"/>
        </tgt_motion>
      </par_motion>
    </sign_manual>
    <sign_manual both_hands="true" lr_symm="true">
      <handconfig handshape="flat" mainbend="round" second_handshape="flat"/>
      <split_handconfig>
        <handconfig extfidir="l" palmor="l"/>
        <handconfig extfidir="u" palmor="d"/>
      </split_handconfig>
      <split_location>
        <location_hand contact="touch" location="palm">
          <location_hand location="palm"/>
        </location_hand>
        <location_bodyarm location="chest"/>
      </split_location>
      <split_motion>
        <par_motion>
          <directedmotion direction="r"/>
          <directedmotion direction="l"/>
        </par_motion>
        <par_motion>
          <directedmotion direction="u" size="small"/>
          <directedmotion direction="do" size="small"/>
          <tgt_motion>
            <changeposture/>
            <handconfig extfidir="do"/>
          </tgt_motion>
        </par_motion>
      </split_motion>
    </sign_manual>
  </sign_manual>
</hamgestural_sign>

</sigml>
