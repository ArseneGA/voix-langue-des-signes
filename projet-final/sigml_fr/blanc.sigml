<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="white1">
  <sign_manual>
    <handconfig handshape="pinchall"/>
    <handconfig extfidir="ui"/>
    <handconfig palmor="d" second_palmor="dl"/>
    <location_bodyarm contact="touch" location="neck" side="right_at"/>
    <par_motion>
      <directedmotion direction="or"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2345" thumbpos="out"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
