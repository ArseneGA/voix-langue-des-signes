<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="butter1">
  <sign_manual>
    <split_handconfig>
      <handconfig bend2="bent" bend3="bent" handshape="finger23" thumbpos="out"/>
      <handconfig handshape="flat"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="o" palmor="dl"/>
      <handconfig extfidir="o" palmor="ur"/>
    </split_handconfig>
    <location_hand contact="touch" location="palm">
      <location_hand digits="3" location="tip"/>
    </location_hand>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion direction="i" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="fist" thumbpos="out"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
