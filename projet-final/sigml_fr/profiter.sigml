<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="enjoy1">
  <sign_manual>
    <handconfig handshape="cee12open" mainbend="bent"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="close" location="shouldertop" side="right_at"/>
    <tgt_motion>
      <changeposture/>
      <handconfig handshape="pinch12open" mainbend="bent"/>
      <handconfig palmor="u"/>
      <location_bodyarm contact="touch" location="chin">
        <location_hand digits="2" location="tip"/>
      </location_bodyarm>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
