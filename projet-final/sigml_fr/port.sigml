<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="port1">
  <sign_manual both_hands="true">
    <handconfig handshape="flat"/>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="l"/>
      <handconfig extfidir="or" palmor="r"/>
    </split_handconfig>
    <location_hand contact="touch" digits="2" location="tip"/>
    <directedmotion direction="l"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
