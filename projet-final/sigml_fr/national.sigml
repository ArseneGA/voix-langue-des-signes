<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="national1">
  <sign_manual>
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="ul"/>
    <location_bodyarm contact="close" location="shouldertop" side="left_at"/>
    <tgt_motion>
      <directedmotion direction="di" tense="true" zigzag_style="wavy"/>
      <location_bodyarm contact="close" location="stomach" side="right_at"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
