<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="somewhere1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="opposed"/>
    <handconfig extfidir="or"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="shoulders" side="right_beside"/>
    <rpt_motion repetition="fromstart_several">
      <circularmotion axis="d" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
