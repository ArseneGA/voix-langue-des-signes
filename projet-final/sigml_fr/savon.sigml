<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="soap1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="ul"/>
    <location_bodyarm location="cheek" side="right_beside"/>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="r" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
