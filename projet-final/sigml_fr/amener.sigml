<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="bring1">
  <sign_manual both_hands="true">
    <split_handconfig>
      <handconfig handshape="pinch12open"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="or" palmor="d"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand location="handback"/>
      <location_hand location="tip"/>
      <location_bodyarm location="chest" side="right_at"/>
    </handconstellation>
    <directedmotion curve="u" curve_size="small" direction="l"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
