<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="cough1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="lips"/>
    <rpt_motion repetition="fromstart_several">
      <circularmotion axis="r" size="small" start="r"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
