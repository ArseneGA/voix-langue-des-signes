<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="crooked1">
  <sign_manual>
    <handconfig handshape="pinchall"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="d"/>
    <split_location>
      <location_hand contact="touch" digits="2" location="side">
        <location_hand digits="2" location="side"/>
      </location_hand>
      <location_bodyarm location="chest"/>
    </split_location>
    <directedmotion direction="r"/>
    <par_motion>
      <directedmotion direction="d"/>
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="l"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
