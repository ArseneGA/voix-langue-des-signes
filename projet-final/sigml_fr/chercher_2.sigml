<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="seek1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger23spread" mainbend="hooked" thumbpos="across"/>
    <handconfig extfidir="uo"/>
    <handconfig palmor="d"/>
    <location_hand location="palm"/>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <wristmotion motion="stirccw"/>
        <circularmotion axis="i" size="small"/>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
