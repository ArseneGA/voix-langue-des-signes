<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="index_seul">
  <sign_manual>
    <!-- Index seul (finger2), pouce rentré (across) -->
    <handconfig handshape="finger2" thumbpos="across"/>
    
    <handconfig extfidir="u"/>
    
    <!-- Paume face spectateur (l) ou dos (d) ? -->
    <!-- Pour H, souvent dos (d) -->
    <handconfig palmor="d"/>
    
    <location_bodyarm location="chest"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
