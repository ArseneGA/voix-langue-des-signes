<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="wonderful1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" mainbend="round"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="dl"/>
    <split_location>
      <location_bodyarm contact="close" location="chest" side="right_at"/>
      <location_bodyarm location="chest" side="left_at"/>
    </split_location>
    <tgt_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2345" second_handshape="finger2345" second_mainbend="bent" second_thumbpos="out" thumbpos="out"/>
      </tgt_motion>
      <split_location>
        <location_bodyarm contact="close" location="shoulders" side="left_at"/>
        <location_bodyarm location="shoulders" side="right_at"/>
      </split_location>
    </tgt_motion>
    <par_motion>
      <directedmotion direction="or" size="big"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="fist" thumbpos="across"/>
        <handconfig extfidir="o" palmor="l"/>
        <location_bodyarm location="chest" side="right_beside"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
