<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="week1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="across"/>
      <handconfig handshape="ceeall"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ul" palmor="dl"/>
      <handconfig extfidir="r" palmor="d"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="elbowinside" second_location="lowerarm"/>
      <location_bodyarm contact="close" location="shoulders" side="right_at"/>
    </split_location>
    <directedmotion curve="d" direction="o"/>
    <par_motion>
      <directedmotion direction="o" size="small"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="l" palmor="d"/>
        <location_bodyarm contact="touch" location="elbowinside" second_location="lowerarm">
          <location_hand digits="1" location="midjoint"/>
        </location_bodyarm>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
