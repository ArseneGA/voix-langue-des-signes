<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="knowledge1">
  <sign_manual>
    <handconfig handshape="flat" mainbend="bent"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="close" location="forehead" side="right_at"/>
    <par_motion>
      <directedmotion direction="i"/>
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="ul"/>
        <location_bodyarm contact="touch" location="forehead" side="right_at">
          <location_hand digits="3" location="tip"/>
        </location_bodyarm>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
