<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="ice1">
  <sign_manual>
    <handconfig handshape="cee12" specialfingers="23"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="chin" side="right_at">
      <location_hand digits="2" location="midjoint"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="r" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
