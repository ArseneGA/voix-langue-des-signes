<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="bottle1">
  <sign_manual>
    <handconfig handshape="ceeall"/>
    <split_handconfig>
      <handconfig extfidir="l" palmor="l"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <location_hand contact="touch" digits="1" location="side">
      <location_hand digits="5" location="side"/>
    </location_hand>
    <par_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="fist" thumbpos="across"/>
      </tgt_motion>
      <directedmotion direction="u"/>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
