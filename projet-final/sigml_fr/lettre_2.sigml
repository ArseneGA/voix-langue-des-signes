<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="letter1">
  <sign_manual>
    <split_handconfig>
      <handconfig bend3="hooked" bend5="bent" handshape="finger2345" thumbpos="out"/>
      <handconfig handshape="flat"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="u"/>
      <handconfig extfidir="r" palmor="ur"/>
    </split_handconfig>
    <location_hand contact="touch" digits="1" location="tip">
      <location_hand digits="3" location="nail" side="palmar"/>
    </location_hand>
    <wristmotion motion="twisting"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
