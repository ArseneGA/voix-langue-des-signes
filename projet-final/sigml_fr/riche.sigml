<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="rich1">
  <sign_manual>
    <handconfig handshape="finger2345" mainbend="round" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="shoulders">
      <location_hand digits="3" location="tip"/>
    </location_bodyarm>
    <directedmotion direction="o"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
