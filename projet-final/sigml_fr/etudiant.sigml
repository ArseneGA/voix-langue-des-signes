<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="student1">
  <sign_manual>
    <handconfig handshape="flat" thumbpos="opposed"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="r"/>
    <location_bodyarm contact="touch" location="forehead" side="right_at">
      <location_hand digits="2" location="tip"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion curve="u" direction="o" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="flat" mainbend="bent" thumbpos="opposed"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
