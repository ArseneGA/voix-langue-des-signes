<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="call2">
  <sign_manual>
    <handconfig handshape="flat" mainbend="bent"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="dr"/>
    <location_bodyarm contact="close" location="neck" side="right_beside"/>
    <rpt_motion repetition="fromstart_several">
      <directedmotion direction="o" fast="true"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
