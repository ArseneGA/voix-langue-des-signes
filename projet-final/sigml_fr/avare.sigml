<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="stingy1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2345" mainbend="hooked" second_handshape="finger2345" second_thumbpos="out" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="o" palmor="d"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand digits="3" location="midjoint" side="palmar"/>
      <location_hand digits="3" location="tip"/>
    </handconstellation>
    <tgt_motion>
      <directedmotion direction="il"/>
      <handconstellation contact="touch">
        <location_hand location="wristback" side="palmar"/>
        <location_hand digits="3" location="tip"/>
      </handconstellation>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
