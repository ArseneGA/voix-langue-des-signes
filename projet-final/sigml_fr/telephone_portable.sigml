<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="mobile_phone1">
  <sign_manual>
    <handconfig handshape="pinch12" specialfingers="345"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="cheek"/>
    <rpt_motion repetition="reverse" second_repetition="reverse">
      <directedmotion direction="r" fast="true" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
