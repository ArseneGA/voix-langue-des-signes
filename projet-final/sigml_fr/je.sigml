<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="me1">
  <sign_manual>
    <handconfig handshape="finger2" second_handshape="finger2" second_mainbend="bent" second_thumbpos="across" thumbpos="across"/>
    <handconfig extfidir="il"/>
    <handconfig palmor="r"/>
    <location_bodyarm contact="close" location="chest"/>
    <tgt_motion>
      <directedmotion direction="i" size="small"/>
      <location_bodyarm contact="touch" location="chest"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
