<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="steak1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shoulders" second_location="shoulders" side="right_at"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <tgt_motion>
      <directedmotion direction="d"/>
      <handconstellation contact="touch">
        <location_hand location="palm"/>
        <location_hand location="palm"/>
      </handconstellation>
    </tgt_motion>
    <directedmotion direction="u"/>
    <par_motion>
      <directedmotion direction="d"/>
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="u"/>
        <handconstellation contact="touch">
          <location_hand location="midjoint" side="palmar"/>
          <location_hand location="handback"/>
        </handconstellation>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
