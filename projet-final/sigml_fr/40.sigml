<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="forty1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="shouldertop"/>
    <rpt_motion repetition="continue">
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2345" mainbend="hooked" thumbpos="across"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
