<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="wind1">
  <sign_manual both_hands="true">
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <split_handconfig>
      <handconfig extfidir="ur" palmor="l"/>
      <handconfig extfidir="ur" palmor="l"/>
    </split_handconfig>
    <location_bodyarm contact="close" location="shouldertop"/>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion direction="ol"/>
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="ol" palmor="d"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
