<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="room1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="pinch12open" mainbend="bent"/>
    <handconfig extfidir="o" second_extfidir="ol"/>
    <handconfig palmor="dl"/>
    <location_hand contact="touch" digits="2" location="tip"/>
    <directedmotion direction="r" size="small"/>
    <directedmotion direction="o" size="small"/>
    <tgt_motion>
      <directedmotion direction="l" size="small"/>
      <location_hand contact="touch" digits="2" location="tip"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
