<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="group1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="ceeall"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="l"/>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <directedmotion direction="r"/>
        <location_hand contact="touch" digits="3" location="tip"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
