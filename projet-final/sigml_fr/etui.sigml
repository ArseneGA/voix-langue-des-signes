<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="case1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="ceeall" mainbend="bent"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="chest"/>
    <directedmotion direction="u"/>
    <split_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2" mainbend="hooked"/>
        <handconfig extfidir="o" palmor="d"/>
        <location_hand contact="touch" digits="1" location="tip">
          <location_hand digits="1" location="nail"/>
        </location_hand>
      </tgt_motion>
      <par_motion>
        <directedmotion direction="r"/>
        <directedmotion direction="l"/>
      </par_motion>
    </split_motion>
    <split_motion>
      <directedmotion direction="r"/>
      <par_motion>
        <directedmotion direction="r"/>
        <directedmotion direction="l"/>
      </par_motion>
    </split_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
