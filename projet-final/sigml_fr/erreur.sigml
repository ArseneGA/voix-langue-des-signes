<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="error1">
  <sign_manual>
    <handconfig handshape="finger2" specialfingers="5" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="close" location="neck"/>
    <tgt_motion>
      <directedmotion direction="i"/>
      <location_bodyarm contact="touch" location="chin">
        <location_hand digits="3" location="midjoint"/>
      </location_bodyarm>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
