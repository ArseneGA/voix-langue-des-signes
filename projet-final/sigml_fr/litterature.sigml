<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="literature1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="uo" palmor="dl"/>
      <handconfig extfidir="uo" palmor="r" second_extfidir="or"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shoulders"/>
      <location_bodyarm location="shoulders" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <circularmotion axis="i" size="small"/>
        <handconstellation contact="touch">
          <location_hand location="palm"/>
          <location_hand digits="1" location="tip"/>
        </handconstellation>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
