<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="meet1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" thumbpos="across"/>
    <split_handconfig>
      <handconfig extfidir="u" palmor="dl"/>
      <handconfig extfidir="u" palmor="ur"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="chest" side="right_at"/>
      <location_bodyarm location="chest" side="left_at"/>
    </split_location>
    <tgt_motion>
      <directedmotion direction="ol"/>
      <location_hand contact="touch" digits="1" location="nail" side="palmar"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
