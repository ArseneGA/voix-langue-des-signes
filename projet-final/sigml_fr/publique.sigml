<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="public1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig bend3="bent" handshape="finger23spread" thumbpos="across"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="l"/>
    <location_hand contact="close" digits="2" location="tip"/>
    <par_motion>
      <directedmotion direction="or"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="or"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
