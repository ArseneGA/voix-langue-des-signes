<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="under1">
  <sign_manual>
    <handconfig handshape="flat" mainbend="bent" thumbpos="out"/>
    <split_handconfig>
      <handconfig extfidir="u" palmor="l"/>
      <handconfig extfidir="u" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="touch" digits="3" location="nail" side="palmar">
        <location_hand digits="3" location="midjoint"/>
      </location_hand>
      <location_bodyarm location="shoulders"/>
    </split_location>
    <directedmotion direction="d" size="small"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
