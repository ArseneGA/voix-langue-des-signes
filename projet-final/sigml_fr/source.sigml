<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="source1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2" mainbend="round" thumbpos="across"/>
      <handconfig handshape="fist"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="touch" location="lowerarm">
        <location_hand digits="2" location="tip"/>
      </location_bodyarm>
      <location_bodyarm location="chest" second_location="stomach"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="il" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
