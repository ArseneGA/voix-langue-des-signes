<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="taxi1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2345" mainbend="hooked" thumbpos="across"/>
      <handconfig handshape="flat" mainbend="round" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ul" palmor="r" second_extfidir="u"/>
      <handconfig extfidir="r" palmor="d"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="touch" location="wristback">
        <location_hand location="wristback"/>
      </location_hand>
      <location_bodyarm location="chest"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="ur" palmor="l" second_extfidir="u"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
