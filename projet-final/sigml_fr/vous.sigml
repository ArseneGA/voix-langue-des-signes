<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="you1">
  <sign_manual>
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="shoulders" side="left_at"/>
    <par_motion>
      <directedmotion direction="r"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="o" palmor="d"/>
        <location_bodyarm location="shoulders" side="right_at"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
