<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="rain1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" mainbend="round" thumbpos="out"/>
    <handconfig extfidir="uol"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="headtop"/>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <tgt_motion>
          <directedmotion direction="d"/>
          <location_bodyarm location="shoulders"/>
        </tgt_motion>
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="ol"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
