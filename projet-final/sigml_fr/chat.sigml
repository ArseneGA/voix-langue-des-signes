<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="cat1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger23" mainbend="dblbent" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="cheek"/>
    <par_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger23spread" thumbpos="out"/>
        <handconfig palmor="dl"/>
      </tgt_motion>
      <directedmotion direction="r"/>
      <directedmotion direction="dr" fast="true" size="small"/>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
