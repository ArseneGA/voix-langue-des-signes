<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="knife1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2" thumbpos="across"/>
      <handconfig handshape="finger2" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="l"/>
      <handconfig extfidir="or" palmor="d"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="cross" digits="2" location="side"/>
      <location_hand location="midjoint"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <directedmotion direction="ir" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
