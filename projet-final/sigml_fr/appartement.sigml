<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="apartment1">
  <sign_manual>
    <handconfig handshape="finger23spread" thumbpos="out"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="shouldertop"/>
    <directedmotion direction="d" size="small"/>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="u" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
