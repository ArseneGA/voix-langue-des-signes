<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="big1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" second_handshape="finger2345" second_mainbend="round" second_thumbpos="out" thumbpos="out"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="dl" second_palmor="l"/>
    <handconstellation contact="close"/>
    <directedmotion direction="r"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
