<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="ribbon1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="d"/>
    <handconstellation contact="interlock">
      <location_bodyarm location="chest"/>
    </handconstellation>
    <par_motion>
      <directedmotion direction="ur"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="u" palmor="u"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
