<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="beer1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" mainbend="hooked" thumbpos="opposed"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="chest"/>
    <tgt_motion>
      <changeposture/>
      <handconfig handshape="fist" thumbpos="out"/>
      <handconfig extfidir="o"/>
      <location_hand contact="close" digits="2" location="midjoint">
        <location_hand digits="2" location="midjoint"/>
      </location_hand>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
