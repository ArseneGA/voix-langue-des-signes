<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="doctor1">
  <sign_manual>
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <handconfig extfidir="il"/>
    <handconfig palmor="r"/>
    <location_bodyarm contact="touch" location="shoulders" side="left_at">
      <location_hand digits="3" location="nail" side="palmar"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <wristmotion motion="stircw"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
