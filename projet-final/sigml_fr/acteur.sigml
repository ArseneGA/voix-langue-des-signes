<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="actor1">
  <sign_manual both_hands="true" lr_symm="true" oi_symm="true" ud_symm="true">
    <handconfig handshape="flat" mainbend="bent" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_bodyarm contact="touch" location="shoulders" side="right_at"/>
      <location_bodyarm location="shoulders" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <circularmotion axis="l"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
