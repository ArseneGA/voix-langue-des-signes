<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="pharmacy1">
  <sign_manual>
    <handconfig handshape="finger23" thumbpos="across"/>
    <split_handconfig>
      <handconfig extfidir="u" palmor="u"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="shoulders" second_location="shoulders" side="right_at">
        <location_hand digits="2" location="midjoint"/>
      </location_bodyarm>
      <location_bodyarm location="shoulders"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <directedmotion direction="o"/>
        <location_hand contact="touch" digits="2" location="side" side="left_at">
          <location_hand digits="2" location="side" side="right_at"/>
        </location_hand>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
