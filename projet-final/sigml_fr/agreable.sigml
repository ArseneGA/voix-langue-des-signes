<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="pleasant1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="close" location="lips" side="right_at">
      <location_hand digits="3" location="nail" side="palmar"/>
    </location_bodyarm>
    <par_motion>
      <directedmotion direction="l"/>
      <fingerplay/>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
