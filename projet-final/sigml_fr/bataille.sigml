<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="battle1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="d"/>
    <rpt_motion repetition="fromstart_several">
      <seq_motion>
        <tgt_motion>
          <directedmotion curve="d" curve_size="small" direction="ul"/>
          <handconstellation contact="interlock"/>
        </tgt_motion>
        <directedmotion curve="u" curve_size="small" direction="dr"/>
      </seq_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
