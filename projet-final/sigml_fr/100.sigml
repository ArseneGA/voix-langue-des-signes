<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="hundred1">
  <sign_manual>
    <handconfig handshape="ceeall"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="dl"/>
    <location_bodyarm location="shoulders"/>
    <par_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="u" palmor="d"/>
      </tgt_motion>
      <directedmotion direction="r"/>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
