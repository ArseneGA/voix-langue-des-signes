<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="debts1">
  <sign_manual both_hands="true">
    <split_handconfig>
      <handconfig handshape="finger2" thumbpos="across"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="d" palmor="d"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand location="palm"/>
      <location_hand digits="2" location="nail" side="palmar"/>
    </handconstellation>
    <rpt_motion repetition="fromstart_several">
      <directedmotion direction="do" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
