<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="rare1">
  <sign_manual>
    <handconfig contactkind="nail" contactpair="23" handshape="finger23" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="shoulders" side="right_at"/>
    <directedmotion direction="u" ellipse_direction="h" zigzag_size="small" zigzag_style="zigzag"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
