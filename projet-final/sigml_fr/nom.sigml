<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="surname1">
  <sign_manual>
    <handconfig handshape="finger23" thumbpos="across"/>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="l"/>
      <handconfig extfidir="or" palmor="r"/>
    </split_handconfig>
    <location_bodyarm contact="close" location="shoulders"/>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <directedmotion direction="d"/>
        <location_hand contact="touch" digits="2" location="side" side="left_at">
          <location_hand digits="3" location="side" side="right_at"/>
        </location_hand>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
