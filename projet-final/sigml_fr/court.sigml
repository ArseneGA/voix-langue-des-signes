<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="short1">
  <sign_manual>
    <handconfig bend2="dblhooked" bend3="dblhooked" bend4="dblhooked" handshape="flat" thumbpos="out"/>
    <handconfig extfidir="uo"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="chin"/>
    <rpt_motion repetition="fromstart">
      <directedmotion curve="d" curve_size="small" direction="d" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
