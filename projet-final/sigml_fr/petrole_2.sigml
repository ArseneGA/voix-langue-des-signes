<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="petrol1">
  <sign_manual>
    <handconfig handshape="pinch12" specialfingers="345"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="touch" location="chest" side="left_at">
      <location_hand digits="1" location="tip"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <directedmotion curve="d" direction="o" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
