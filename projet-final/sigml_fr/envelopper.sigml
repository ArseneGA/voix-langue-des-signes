<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="wrap1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="u"/>
    <location_bodyarm location="chest" side="right_at"/>
    <split_motion>
      <par_motion>
        <directedmotion curve="u" direction="l" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig palmor="d"/>
        </tgt_motion>
      </par_motion>
      <directedmotion direction="u" size="small"/>
    </split_motion>
    <split_motion>
      <directedmotion direction="u" size="small"/>
      <par_motion>
        <directedmotion curve="u" direction="r" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig palmor="d"/>
        </tgt_motion>
      </par_motion>
    </split_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
