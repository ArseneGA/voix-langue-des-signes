<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="aunt1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig contactkind="nail" contactpair="12" handshape="finger2345"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="shouldertop" side="right_at"/>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="d" fast="true" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
