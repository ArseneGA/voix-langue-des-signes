<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="opinion1">
  <sign_manual>
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="dl"/>
    <location_bodyarm location="forehead" side="right_at"/>
    <par_motion>
      <directedmotion curve="u" direction="d"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2345" thumbpos="out"/>
        <handconfig palmor="l"/>
        <location_bodyarm contact="touch" location="chest">
          <location_hand location="palm"/>
        </location_bodyarm>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
