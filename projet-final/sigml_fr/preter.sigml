<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="lend1">
  <sign_manual both_hands="true">
    <split_handconfig>
      <handconfig handshape="finger23spread" mainbend="hooked" second_handshape="finger23spread" second_thumbpos="across" thumbpos="across"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="dl"/>
      <handconfig extfidir="r" palmor="dr"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand location="thumbside"/>
      <location_hand location="wristback"/>
    </handconstellation>
    <directedmotion curve="u" direction="o" size="small"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
