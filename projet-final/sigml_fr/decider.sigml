<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="decide1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="d"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="chest"/>
    <par_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="o"/>
      </tgt_motion>
      <directedmotion curve="d" direction="do" halt="true" size="small"/>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
