<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="write1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="pinch12" mainbend="bent"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="or" palmor="ur"/>
    </split_handconfig>
    <location_hand contact="close" location="palm">
      <location_hand digits="2" location="tip"/>
    </location_hand>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="d" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
