<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="back1">
  <sign_manual>
    <handconfig handshape="flat"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="close" location="shouldertop" side="right_at"/>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="ui" palmor="d"/>
        <location_bodyarm contact="touch" location="shouldertop" side="right_at">
          <location_hand digits="2" location="nail" side="palmar"/>
        </location_bodyarm>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
