<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="radio1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger23spread" mainbend="hooked" thumbpos="opposed"/>
    <handconfig extfidir="ur" second_extfidir="or"/>
    <handconfig palmor="l"/>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="or" second_extfidir="r"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
