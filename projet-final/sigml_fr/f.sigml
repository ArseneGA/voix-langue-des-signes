<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="f_alt">
  <sign_manual>
    <!-- Main ouverte, pouce et index pliés pour se toucher -->
    <handconfig handshape="finger2345" thumbpos="opposed" bend1="round" bend2="round"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="chest"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
