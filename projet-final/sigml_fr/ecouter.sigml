<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="hear1">
  <sign_manual>
    <handconfig handshape="ceeall"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="dl" second_palmor="l"/>
    <location_bodyarm contact="touch" location="cheek" side="right_at">
      <location_hand digits="1" location="nail" side="dorsal"/>
    </location_bodyarm>
  </sign_manual>
</hamgestural_sign>

</sigml>
