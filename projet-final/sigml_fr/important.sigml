<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="important1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2" thumbpos="across"/>
      <handconfig handshape="finger2" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="o" palmor="l"/>
      <handconfig extfidir="u" palmor="r"/>
    </split_handconfig>
    <par_motion>
      <directedmotion direction="l"/>
      <directedmotion curve="l" direction="u" size="big"/>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
