<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="accept1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_bodyarm location="shoulders"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <par_motion>
      <directedmotion direction="i" size="big"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="fist" thumbpos="across"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
