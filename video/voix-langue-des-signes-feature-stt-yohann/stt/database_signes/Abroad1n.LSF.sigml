<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="abroad1">
  <sign_manual>
    <sign_manual both_hands="true" lr_symm="true">
      <handconfig handshape="pinchall" mainbend="bent"/>
      <handconfig extfidir="o"/>
      <handconfig palmor="ul" second_palmor="u"/>
      <location_bodyarm location="chest"/>
      <rpt_motion repetition="fromstart_several" repetition_incrdecr="decreasing">
        <directedmotion direction="l" fast="true" size="small"/>
      </rpt_motion>
    </sign_manual>
    <sign_manual both_hands="true">
      <split_handconfig>
        <handconfig handshape="flat" mainbend="bent" thumbpos="out"/>
        <handconfig handshape="flat" mainbend="bent" thumbpos="out"/>
      </split_handconfig>
      <split_handconfig>
        <handconfig extfidir="u" palmor="l"/>
        <handconfig extfidir="u" palmor="r"/>
      </split_handconfig>
      <split_location>
        <location_bodyarm location="headtop" side="right_at"/>
        <location_bodyarm location="head"/>
      </split_location>
      <rpt_motion repetition="fromstart">
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="u" palmor="d"/>
        </tgt_motion>
      </rpt_motion>
    </sign_manual>
  </sign_manual>
</hamgestural_sign>

</sigml>
