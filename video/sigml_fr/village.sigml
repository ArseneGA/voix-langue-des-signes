<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="village1">
  <sign_manual both_hands="true" lr_symm="true" oi_symm="true" outofphase="true" ud_symm="true">
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="d"/>
    <split_location>
      <location_bodyarm location="shoulders" side="right_at"/>
      <location_bodyarm location="chest" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <seq_motion>
        <directedmotion direction="d"/>
        <directedmotion direction="u"/>
      </seq_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
