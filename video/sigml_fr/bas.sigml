<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="low1">
  <sign_manual>
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="d"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="chest"/>
    <rpt_motion repetition="fromstart_several">
      <directedmotion direction="d" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
