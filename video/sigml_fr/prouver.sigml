<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="prove1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat"/>
      <handconfig handshape="flat"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ul" palmor="u" second_extfidir="o"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="shoulders"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <par_motion>
      <directedmotion direction="d" fast="true"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="ol" palmor="u"/>
        <location_hand contact="touch" location="palm">
          <location_hand digits="2" location="tip"/>
        </location_hand>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
