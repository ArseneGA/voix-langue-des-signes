<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="other1">
  <sign_manual>
    <handconfig handshape="flat"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="shoulders" side="right_beside"/>
    <par_motion>
      <directedmotion direction="uo" second_direction="or"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="or" palmor="d" second_extfidir="u"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
