<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="knit1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <split_handconfig>
      <handconfig palmor="dr"/>
      <handconfig palmor="ur"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand digits="2" location="nail" side="palmar"/>
      <location_hand digits="2" location="nail" side="palmar"/>
      <location_bodyarm location="shoulders"/>
    </handconstellation>
    <rpt_motion repetition="continue_several">
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="dl"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
