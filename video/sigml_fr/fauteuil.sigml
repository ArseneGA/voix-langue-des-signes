<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="armchair1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat" mainbend="round"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="close" location="chest" side="right_beside"/>
    <directedmotion direction="d"/>
    <nonman_motion>
      <handconfig bodypart="shoulders"/>
      <directedmotion direction="d"/>
    </nonman_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
