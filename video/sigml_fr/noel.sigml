<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="Christmas1">
  <sign_manual>
    <handconfig handshape="finger2345" mainbend="round" thumbpos="opposed"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="underchin">
      <location_hand location="palm"/>
    </location_bodyarm>
    <par_motion>
      <directedmotion direction="d"/>
      <directedmotion curve="d" direction="o"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="fist" mainbend="dblhooked"/>
        <handconfig extfidir="l" palmor="d"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
