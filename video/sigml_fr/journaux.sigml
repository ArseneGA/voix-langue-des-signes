<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="newspaper1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" mainbend="hooked"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_hand contact="touch" digits="1" location="tip">
        <location_hand digits="1" location="tip"/>
      </location_hand>
      <location_bodyarm location="shoulders"/>
    </split_location>
    <par_motion>
      <directedmotion curve="l" curve_size="big" direction="r"/>
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="u"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
