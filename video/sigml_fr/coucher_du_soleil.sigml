<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="sunset1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="ceeall"/>
      <handconfig handshape="flat"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="l"/>
      <handconfig extfidir="r" palmor="d"/>
    </split_handconfig>
    <location_bodyarm location="shouldertop" side="right_at"/>
    <tgt_motion>
      <par_motion>
        <directedmotion direction="d"/>
        <directedmotion direction="l" tense="true"/>
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="l" palmor="d"/>
        </tgt_motion>
      </par_motion>
      <location_bodyarm contact="close" location="lowerarm">
        <location_hand digits="5" location="nail" side="palmar"/>
      </location_bodyarm>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
