<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="garden1">
  <sign_manual both_hands="true">
    <handconfig handshape="finger23spread" mainbend="round" thumbpos="across"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="d"/>
    <split_location>
      <location_bodyarm location="chest"/>
      <location_bodyarm contact="close" location="chest" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="l" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
