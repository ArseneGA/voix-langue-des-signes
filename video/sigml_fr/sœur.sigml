<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="sister1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="shoulders" side="right_at"/>
    <rpt_motion repetition="fromstart_several">
      <directedmotion direction="l" fast="true" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
