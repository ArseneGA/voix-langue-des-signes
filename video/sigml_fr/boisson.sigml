<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="beverage1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="tongue">
      <location_hand digits="1" location="nail" side="palmar"/>
    </location_bodyarm>
    <par_motion>
      <directedmotion direction="u" size="small"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="ui"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
