<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="robust1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="fist" thumbpos="across"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_bodyarm location="chest" side="right_at"/>
      <location_bodyarm location="chest" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="d" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
