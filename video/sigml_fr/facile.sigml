<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="easy1">
  <sign_manual>
    <handconfig handshape="cee12" mainbend="bent" second_handshape="finger2" second_thumbpos="opposed"/>
    <handconfig extfidir="ul" second_extfidir="l"/>
    <handconfig palmor="ul"/>
    <location_bodyarm contact="touch" location="chin" side="left_at">
      <location_hand digits="2" location="nail" side="palmar"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion direction="do" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="pinch12" mainbend="bent"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
