<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="schedule1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat" mainbend="bent" thumbpos="across"/>
      <handconfig handshape="flat" mainbend="bent" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="l"/>
      <handconfig extfidir="u" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shouldertop" second_location="shoulders" side="right_at"/>
      <location_bodyarm location="shoulders" second_location="chest"/>
    </split_location>
    <rpt_motion repetition="continue_several">
      <directedmotion curve="d" direction="d" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
