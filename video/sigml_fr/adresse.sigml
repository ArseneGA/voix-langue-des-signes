<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="address1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="fist" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="chest" side="right_at">
      <location_hand digits="1" location="tip"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="r" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
