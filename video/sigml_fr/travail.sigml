<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="labour1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="across"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="l"/>
      <handconfig extfidir="or" palmor="r"/>
    </split_handconfig>
    <location_bodyarm location="shoulders"/>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="d" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
