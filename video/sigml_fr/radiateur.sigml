<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="radiator1">
  <sign_manual>
    <sign_manual both_hands="true" lr_symm="true">
      <handconfig handshape="ceeall" mainbend="bent"/>
      <handconfig extfidir="or"/>
      <handconfig palmor="dl"/>
      <location_bodyarm contact="close" location="chest"/>
      <par_motion>
        <directedmotion curve="d" curve_size="small" direction="d" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig palmor="l"/>
        </tgt_motion>
      </par_motion>
    </sign_manual>
    <sign_manual both_hands="true" lr_symm="true">
      <handconfig handshape="ceeall" mainbend="bent"/>
      <handconfig extfidir="or"/>
      <handconfig palmor="dl"/>
      <location_bodyarm contact="close" location="chest" side="right_at"/>
      <par_motion>
        <directedmotion curve="d" curve_size="small" direction="d" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig palmor="l"/>
        </tgt_motion>
      </par_motion>
    </sign_manual>
  </sign_manual>
</hamgestural_sign>

</sigml>
