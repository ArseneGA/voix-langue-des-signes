<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="often1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="pinchall"/>
    <handconfig extfidir="uo"/>
    <handconfig palmor="u"/>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion direction="o" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="finger2345" second_handshape="finger2345" second_mainbend="bent" second_thumbpos="out" thumbpos="out"/>
          <handconfig extfidir="o" palmor="u"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
