<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="plane1">
  <sign_manual>
    <handconfig bend2="dblhooked" bend3="dblhooked" bend4="dblhooked" handshape="flat" thumbpos="out"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="shouldertop" side="right_beside"/>
    <tgt_motion>
      <directedmotion direction="l" slow="true"/>
      <location_bodyarm location="shouldertop" side="left_beside"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
