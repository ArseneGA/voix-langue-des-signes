<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="wild1">
  <sign_manual>
    <handconfig handshape="flat" thumbpos="out"/>
    <split_handconfig>
      <handconfig extfidir="o" palmor="u"/>
      <handconfig extfidir="r" palmor="d"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="touch" location="palm">
        <location_hand location="palm"/>
      </location_hand>
      <location_bodyarm location="chest"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <seq_motion>
        <directedmotion direction="r"/>
        <par_motion>
          <directedmotion direction="ur"/>
          <tgt_motion>
            <changeposture/>
            <handconfig palmor="ul"/>
          </tgt_motion>
        </par_motion>
      </seq_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
