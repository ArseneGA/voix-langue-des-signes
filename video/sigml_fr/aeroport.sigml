<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="airport1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2" specialfingers="5" thumbpos="out"/>
      <handconfig handshape="flat"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <location_hand contact="touch" location="palm">
      <location_hand digits="3" location="midjoint"/>
    </location_hand>
    <rpt_motion repetition="fromstart">
      <directedmotion curve="l" direction="or" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
