<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="bakery1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="u"/>
    <split_location>
      <location_bodyarm location="chest" side="right_at"/>
      <location_bodyarm contact="close" location="chest"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="o" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
