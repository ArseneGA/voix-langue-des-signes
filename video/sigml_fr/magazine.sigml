<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="magazine1">
  <sign_manual>
    <split_handconfig>
      <handconfig bend3="bent" handshape="finger2345" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="o" palmor="dl"/>
      <handconfig extfidir="o" palmor="ur"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="chest" side="right_at"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <circularmotion axis="o" size="small"/>
        <handconstellation contact="touch">
          <location_hand location="palm"/>
          <location_hand digits="3" location="tip"/>
        </handconstellation>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
