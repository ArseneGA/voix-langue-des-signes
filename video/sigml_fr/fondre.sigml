<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="melt1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" thumbpos="opposed"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="u"/>
    <handconstellation contact="touch">
      <location_hand digits="2" location="midjoint"/>
      <location_hand digits="2" location="midjoint"/>
      <location_bodyarm location="shoulders"/>
    </handconstellation>
    <par_motion>
      <directedmotion direction="dr"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="pinchall" mainbend="bent" second_handshape="pinchall"/>
        <handconfig extfidir="dl"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
