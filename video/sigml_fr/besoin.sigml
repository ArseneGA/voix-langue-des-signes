<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="need1">
  <sign_manual>
    <handconfig handshape="flat" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="shouldertop"/>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="d"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
