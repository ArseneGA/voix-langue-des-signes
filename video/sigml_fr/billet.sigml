<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="ticket1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="cee12"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="l"/>
    <location_hand contact="touch" digits="2" location="tip"/>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion direction="r" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig palmor="d"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
