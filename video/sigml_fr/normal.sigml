<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="normal1">
  <sign_manual>
    <handconfig handshape="finger2" mainbend="hooked"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="close" location="shouldertop" side="right_at"/>
    <par_motion>
      <directedmotion curve="d" direction="dl"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="l" palmor="l"/>
      </tgt_motion>
    </par_motion>
    <par_motion>
      <directedmotion curve="u" direction="dr"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="o" palmor="l"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
