<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="carry1">
  <sign_manual both_hands="true">
    <handconfig handshape="flat" mainbend="bent"/>
    <handconfig extfidir="do"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="stomach"/>
    <directedmotion direction="u" size="small"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
