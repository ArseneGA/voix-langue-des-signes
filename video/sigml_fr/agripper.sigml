<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="grab1">
  <sign_manual both_hands="true">
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="close" location="shouldertop"/>
    <par_motion>
      <directedmotion direction="d"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="fist" thumbpos="across"/>
        <handconfig extfidir="o" palmor="l"/>
      </tgt_motion>
    </par_motion>
    <directedmotion direction="o" fast="true" size="small"/>
    <directedmotion direction="i" fast="true" size="small"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
