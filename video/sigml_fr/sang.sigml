<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="blood1">
  <sign_manual>
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="touch" location="lips">
      <location_hand digits="2" location="nail" side="palmar"/>
    </location_bodyarm>
    <par_motion>
      <directedmotion direction="do"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2345" thumbpos="out"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
