<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="in_front_of1">
  <sign_manual>
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <split_handconfig>
      <handconfig extfidir="ul" palmor="l"/>
      <handconfig extfidir="ur" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="touch" digits="2" location="nail">
        <location_hand digits="2" location="nail" side="palmar"/>
      </location_hand>
      <location_bodyarm contact="close" location="chest" second_location="shoulders"/>
    </split_location>
    <directedmotion curve="u" direction="o"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
