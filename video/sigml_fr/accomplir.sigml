<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="achieve1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="chest"/>
    <tgt_motion>
      <changeposture/>
      <handconfig extfidir="dl" palmor="l"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
