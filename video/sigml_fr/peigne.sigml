<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="comb1">
  <sign_manual>
    <handconfig handshape="finger2" mainbend="hooked"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="ear" side="right_at"/>
    <rpt_motion repetition="fromstart">
      <directedmotion curve="u" direction="i" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
