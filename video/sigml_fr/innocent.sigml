<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="innocent1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig bend3="bent" handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="touch" location="chest" side="right_at">
      <location_hand digits="3" location="tip"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion direction="do" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="o" palmor="d"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
