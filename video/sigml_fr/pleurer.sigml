<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="cry1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" thumbpos="out"/>
    <handconfig extfidir="ul" second_extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="eyes">
      <location_hand location="tip"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="fist" thumbpos="out"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
