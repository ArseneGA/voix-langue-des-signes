<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="v">
  <sign_manual>
    <!-- Main : V (Index et Majeur écartés) -->
    <handconfig handshape="finger23spread" thumbpos="across"/>
    
    <!-- Orientation : Verticale, Paume face spectateur -->
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    
    <location_bodyarm location="shouldertop" side="right_beside"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
