<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="strong1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="fist" thumbpos="across"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="ul"/>
    <par_motion>
      <directedmotion direction="u" fast="true" halt="true" size="big"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="u" palmor="u"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
