<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="pray1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" mainbend="round" thumbpos="opposed"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_hand contact="touch" location="palm">
        <location_hand location="palm"/>
      </location_hand>
      <location_bodyarm location="shoulders"/>
    </split_location>
  </sign_manual>
</hamgestural_sign>

</sigml>
