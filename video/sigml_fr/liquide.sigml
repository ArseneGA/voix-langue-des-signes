<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="liquid1">
  <sign_manual both_hands="true">
    <handconfig handshape="finger2345" thumbpos="out"/>
    <split_handconfig>
      <handconfig extfidir="l" palmor="d"/>
      <handconfig extfidir="r" palmor="d"/>
    </split_handconfig>
    <location_bodyarm location="shoulders"/>
    <rpt_motion repetition="fromstart">
      <seq_motion>
        <par_motion>
          <directedmotion direction="r"/>
          <fingerplay/>
        </par_motion>
        <par_motion>
          <directedmotion direction="l"/>
          <fingerplay/>
        </par_motion>
      </seq_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
