<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="objection1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="d"/>
    <split_location>
      <location_bodyarm contact="close" location="forehead" side="right_at"/>
      <location_bodyarm location="shoulders"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion direction="o" fast="true" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="finger2" thumbpos="across"/>
          <handconfig extfidir="ul" palmor="dr"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
