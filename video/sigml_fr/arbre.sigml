<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="tree1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="out"/>
    <split_handconfig>
      <handconfig extfidir="u" palmor="l"/>
      <handconfig extfidir="r" palmor="d"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="touch" location="handback">
        <location_hand location="elbowinside"/>
      </location_hand>
      <location_bodyarm location="chest" side="right_at"/>
    </split_location>
    <rpt_motion repetition="fromstart_several" second_repetition="fromstart_several">
      <tgt_motion fast="true">
        <changeposture/>
        <handconfig palmor="ul"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
