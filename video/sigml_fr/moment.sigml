<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="moment1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2" mainbend="hooked" thumbpos="across"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ur" palmor="ul" second_extfidir="or"/>
      <handconfig extfidir="ol" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="chest" side="right_at"/>
      <location_bodyarm location="chest" side="left_at"/>
    </split_location>
    <par_motion>
      <tgt_motion>
        <directedmotion direction="l"/>
        <handconstellation contact="touch">
          <location_hand location="palm"/>
          <location_hand digits="2" location="midjoint"/>
        </handconstellation>
      </tgt_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="ol" palmor="l"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
