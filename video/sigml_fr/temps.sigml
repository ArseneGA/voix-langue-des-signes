<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="time1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="pinch12open"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="close" location="chest"/>
    <par_motion>
      <directedmotion direction="or"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2345" thumbpos="out"/>
        <handconfig extfidir="ur" palmor="l"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
