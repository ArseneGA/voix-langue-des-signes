<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="middle1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="l" palmor="r"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shoulders"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <tgt_motion>
      <directedmotion direction="d"/>
      <handconstellation contact="touch">
        <location_hand location="palm"/>
        <location_hand digits="1" location="tip"/>
      </handconstellation>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
