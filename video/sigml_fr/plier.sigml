<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="bend1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="across"/>
      <handconfig handshape="finger2" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="d"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="forehead" side="right_beside"/>
      <location_bodyarm contact="close" location="shouldertop" side="right_at"/>
    </split_location>
    <par_motion>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="uo" palmor="d"/>
      </tgt_motion>
      <directedmotion curve="u" direction="do" slow="true"/>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
