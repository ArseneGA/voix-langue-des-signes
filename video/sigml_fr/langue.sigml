<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="tongue1">
  <sign_manual>
    <handconfig handshape="cee12"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="lips">
      <location_hand digits="1" location="tip" second_digits="2" second_location="tip"/>
    </location_bodyarm>
    <par_motion>
      <directedmotion curve="u" direction="do"/>
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="ul"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
