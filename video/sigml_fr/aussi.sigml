<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="also1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="d"/>
    <tgt_motion>
      <directedmotion direction="l" fast="true" size="small"/>
      <location_hand contact="touch" location="thumbside"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
