<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="wide1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="cee12"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="chest"/>
    <directedmotion direction="r"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
