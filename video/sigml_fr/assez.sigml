<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="enough1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2345" thumbpos="out"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shoulders"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <par_motion>
        <directedmotion direction="uo" size="small"/>
        <directedmotion curve="d" direction="or" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="o"/>
          <handconstellation contact="touch">
            <location_hand location="thumbside"/>
            <location_hand location="palm"/>
          </handconstellation>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
