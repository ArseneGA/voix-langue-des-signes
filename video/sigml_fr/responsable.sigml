<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="responsible1">
  <sign_manual>
    <handconfig handshape="flat"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="touch" location="shoulders" side="left_at">
      <location_hand location="pinkyside"/>
    </location_bodyarm>
    <par_motion>
      <directedmotion direction="o"/>
      <circularmotion axis="r" size="small"/>
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="d"/>
        <location_bodyarm contact="touch" location="shoulders" side="left_at">
          <location_hand location="thumbside"/>
        </location_bodyarm>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
