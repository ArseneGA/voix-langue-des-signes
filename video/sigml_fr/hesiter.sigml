<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="hesitate1">
  <sign_manual both_hands="true" lr_symm="true" ud_symm="true">
    <handconfig handshape="flat" mainbend="round" second_handshape="finger2345" second_thumbpos="out" thumbpos="out"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="u"/>
    <split_location>
      <location_bodyarm location="chest" side="right_at"/>
      <location_bodyarm location="shoulders" side="left_at"/>
    </split_location>
    <directedmotion direction="u"/>
    <directedmotion direction="d"/>
    <directedmotion direction="u"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
