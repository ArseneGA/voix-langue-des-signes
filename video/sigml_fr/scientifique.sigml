<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="scientist1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" mainbend="hooked" second_handshape="finger2345" second_thumbpos="out" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="chest">
      <location_hand digits="3" location="tip"/>
    </location_bodyarm>
    <directedmotion curve="r" direction="r" size="small"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
