<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="sleep1">
  <sign_manual>
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="chest" side="right_at"/>
    <par_motion>
      <directedmotion direction="u" tense="true"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="ur" palmor="u" second_extfidir="u"/>
        <location_bodyarm location="cheek"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
