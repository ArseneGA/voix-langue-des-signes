<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="invitation1">
  <sign_manual>
    <handconfig bend2="bent" handshape="finger2345" thumbpos="opposed"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="shoulders"/>
    <par_motion>
      <directedmotion direction="i"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="pinch12open" mainbend="bent"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
