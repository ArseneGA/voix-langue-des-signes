<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="pay1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="do" palmor="d" second_extfidir="d"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <location_hand contact="touch" location="palm">
      <location_hand digits="1" location="tip"/>
    </location_hand>
    <par_motion>
      <directedmotion direction="r"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="or" second_extfidir="do"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
