<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="economy1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="pinch12" mainbend="bent"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="u" second_palmor="l"/>
    <location_bodyarm location="chest"/>
    <rpt_motion repetition="fromstart">
      <split_motion>
        <par_motion>
          <circularmotion axis="d" slow="true" start="l"/>
          <fingerplay/>
        </par_motion>
        <par_motion>
          <circularmotion axis="d" slow="true"/>
          <fingerplay/>
        </par_motion>
      </split_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
