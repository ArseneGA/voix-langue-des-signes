<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="be_sleepy1">
  <sign_manual both_hands="true" lr_symm="true" oi_symm="true" ud_symm="true">
    <handconfig handshape="flat" second_handshape="finger2345" second_thumbpos="out" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_bodyarm contact="touch" location="chest" side="right_at"/>
      <location_bodyarm contact="close" location="chest" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="r"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
