<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="sorry1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="across"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="touch" location="shoulders" second_location="shoulders" side="left_at">
      <location_hand digits="2" location="side"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="i" size="small" slow="true" start="u"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
