<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="employee1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="across"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="l" palmor="d"/>
      <handconfig extfidir="r" palmor="d"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="chest" side="left_at"/>
      <location_bodyarm contact="touch" location="chest" side="right_at"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <directedmotion direction="i"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
