<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="Mayor1">
  <sign_manual>
    <handconfig handshape="ceeall"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="shouldertop" second_location="neck" side="left_at">
      <location_hand digits="1" location="tip"/>
    </location_bodyarm>
    <tgt_motion>
      <changeposture/>
      <handconfig extfidir="d" palmor="d"/>
      <location_bodyarm contact="touch" location="belowstomach" side="right_at">
        <location_hand digits="1" location="tip"/>
      </location_bodyarm>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
