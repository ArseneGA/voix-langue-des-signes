<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="slowly1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="close" location="chest" side="right_at"/>
    <rpt_motion repetition="fromstart">
      <directedmotion curve="d" direction="dr" tense="true"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
