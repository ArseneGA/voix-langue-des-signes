<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="sweep1">
  <sign_manual both_hands="true">
    <handconfig handshape="fist"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_bodyarm location="shoulders" side="right_at"/>
      <location_bodyarm location="chest" side="right_at"/>
    </split_location>
    <rpt_motion repetition="continue_several">
      <par_motion>
        <directedmotion direction="l" size="small"/>
        <tgt_motion>
          <changeposture/>
          <split_handconfig>
            <handconfig palmor="ul"/>
            <handconfig palmor="dr"/>
          </split_handconfig>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
