<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="mountain1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="stomach" second_location="chest" second_side="right_beside"/>
    <tgt_motion>
      <par_motion>
        <directedmotion direction="u"/>
        <wristmotion motion="nodding"/>
      </par_motion>
      <handconstellation contact="touch"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
