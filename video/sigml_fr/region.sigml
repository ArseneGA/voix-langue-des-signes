<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="area1">
  <sign_manual>
    <split_handconfig>
      <handconfig contactkind="nail" contactpair="23" handshape="finger23" thumbpos="across"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="uo" palmor="d"/>
      <handconfig extfidir="uo" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="chest"/>
      <location_bodyarm contact="close" location="stomach"/>
    </split_location>
    <circularmotion axis="do" start="l"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
