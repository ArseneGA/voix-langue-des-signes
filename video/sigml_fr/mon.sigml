<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="my1">
  <sign_manual>
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="chest"/>
    <tgt_motion>
      <directedmotion direction="i"/>
      <handconstellation contact="touch"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
