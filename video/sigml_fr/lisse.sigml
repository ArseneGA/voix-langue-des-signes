<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="smooth1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand location="palm" second_location="wristback"/>
      <location_hand location="palm"/>
      <location_bodyarm location="shoulders" second_location="chest"/>
    </handconstellation>
    <directedmotion direction="or" tense="true"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
