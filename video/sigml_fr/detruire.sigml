<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="ruin1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="o" palmor="d"/>
      <handconfig extfidir="o" palmor="u"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand location="palm"/>
      <location_hand digits="3" location="midjoint" side="dorsal"/>
      <location_bodyarm location="shoulders"/>
    </handconstellation>
    <directedmotion direction="o" size="big" tense="true"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
