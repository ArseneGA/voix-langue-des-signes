<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="cream1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="flat" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="or" palmor="d"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand location="handback"/>
      <location_hand location="palm"/>
      <location_bodyarm location="chest"/>
    </handconstellation>
    <rpt_motion repetition="fromstart_several">
      <circularmotion axis="u" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
