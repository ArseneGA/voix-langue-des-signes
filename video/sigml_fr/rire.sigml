<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="laugh1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig bend2="round" handshape="finger2" thumbpos="out"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_bodyarm location="lips"/>
      <location_bodyarm contact="close" location="lips"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="l" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
