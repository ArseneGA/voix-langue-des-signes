<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="come1">
  <sign_manual>
    <handconfig handshape="finger2" mainbend="round" second_handshape="finger2" second_mainbend="bent" second_thumbpos="across" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="ul"/>
    <location_bodyarm location="shoulders" side="right_beside"/>
    <tgt_motion>
      <changeposture/>
      <handconfig handshape="finger2"/>
      <handconfig extfidir="dl" palmor="l"/>
      <location_bodyarm location="chest"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
