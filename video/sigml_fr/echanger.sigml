<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="exchange1">
  <sign_manual both_hands="true" lr_symm="true" oi_symm="true" ud_symm="true">
    <handconfig handshape="flat"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="ul"/>
    <split_location>
      <location_bodyarm contact="close" location="chest" side="right_at"/>
      <location_bodyarm location="chest" side="left_at"/>
    </split_location>
    <circularmotion axis="l" clockplus="true"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
