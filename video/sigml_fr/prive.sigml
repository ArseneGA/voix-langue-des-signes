<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="private1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="out"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="chest"/>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion direction="i"/>
        <tgt_motion>
          <changeposture/>
          <handconfig extfidir="u"/>
          <location_bodyarm contact="touch" location="chest">
            <location_hand digits="1" location="tip"/>
          </location_bodyarm>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
