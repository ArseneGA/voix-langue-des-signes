<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="without1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="pinch12open"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="dl"/>
    <split_location>
      <location_bodyarm contact="close" location="neck"/>
      <location_hand contact="touch" location="tip"/>
    </split_location>
    <par_motion>
      <directedmotion direction="r" size="small"/>
      <directedmotion direction="ur" size="small"/>
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2345" thumbpos="out"/>
        <handconfig extfidir="ur" palmor="l"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
