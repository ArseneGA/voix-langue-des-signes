<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="face1">
  <sign_manual>
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="ui"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="forehead" second_location="head" second_side="right_at" side="right_beside"/>
    <circularmotion axis="i" start="u"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
