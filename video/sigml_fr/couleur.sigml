<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="colour1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="close" location="underchin" side="right_beside"/>
    <par_motion>
      <tgt_motion>
        <directedmotion direction="l"/>
        <location_bodyarm contact="close" location="underchin" side="left_beside"/>
      </tgt_motion>
      <fingerplay/>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
