<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="want1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" mainbend="round" thumbpos="out"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="u"/>
    <location_bodyarm location="shoulders" second_location="chest"/>
    <directedmotion direction="d"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
