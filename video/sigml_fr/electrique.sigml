<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="electrical1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" mainbend="hooked" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm location="shoulders"/>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <directedmotion direction="l"/>
        <location_hand contact="close" location="thumbball"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
