<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="p">
  <sign_manual>
    <!-- 1. DÉPART TENDU -->
    <handconfig handshape="finger23" thumbpos="across"/>
    <!-- On dit qu'on est "Haut vers Avant" (u, o) pour créer un angle de départ -->
    <handconfig extfidir="u" second_extfidir="uo"/> 
    <handconfig palmor="l"/>
    <location_bodyarm location="chest" side="right_at"/>

    <!-- 2. ARRIVÉE RELACHÉE -->
    <tgt_motion>
      <changeposture/>
      <!-- On finit "Bas vers Arrière" (d, i) -->
      <!-- Cet écart exagéré force une grande rotation -->
      <handconfig extfidir="d" second_extfidir="di"/>
      <handconfig palmor="l"/>
    </tgt_motion>
    
  </sign_manual>
</hamgestural_sign>

</sigml>
