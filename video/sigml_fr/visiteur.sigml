<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="visitor1">
  <sign_manual>
    <sign_manual>
      <handconfig handshape="finger2" mainbend="round" thumbpos="out"/>
      <handconfig extfidir="ur"/>
      <handconfig palmor="l"/>
      <location_bodyarm contact="close" location="shouldertop" side="right_at"/>
      <directedmotion direction="d"/>
    </sign_manual>
    <sign_manual both_hands="true">
      <split_handconfig>
        <handconfig handshape="finger23spread" second_handshape="finger23spread" second_thumbpos="opposed" thumbpos="across"/>
        <handconfig handshape="finger2"/>
      </split_handconfig>
      <split_handconfig>
        <handconfig extfidir="u" palmor="d"/>
        <handconfig extfidir="r" palmor="r"/>
      </split_handconfig>
      <handconstellation contact="touch">
        <location_hand digits="2" location="nail" side="palmar"/>
        <location_hand location="wristback"/>
      </handconstellation>
      <par_motion>
        <rpt_motion repetition="continue_several">
          <directedmotion direction="r" size="small"/>
        </rpt_motion>
        <rpt_motion repetition="fromstart_several">
          <tgt_motion>
            <changeposture/>
            <split_handconfig>
              <handconfig extfidir="o" palmor="d"/>
              <handconfig/>
            </split_handconfig>
          </tgt_motion>
        </rpt_motion>
      </par_motion>
    </sign_manual>
  </sign_manual>
</hamgestural_sign>

</sigml>
