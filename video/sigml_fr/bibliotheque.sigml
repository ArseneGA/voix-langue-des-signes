<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="Library1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <handconstellation contact="touch">
      <location_bodyarm location="head"/>
    </handconstellation>
    <directedmotion direction="r"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
