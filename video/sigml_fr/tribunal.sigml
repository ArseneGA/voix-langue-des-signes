<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="court1">
  <sign_manual both_hands="true" ud_symm="true">
    <handconfig handshape="pinch12open"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_bodyarm location="chest" side="right_at"/>
      <location_bodyarm location="shoulders" side="left_at"/>
    </split_location>
    <directedmotion direction="u"/>
    <rpt_motion repetition="fromstart_several">
      <directedmotion direction="d"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
