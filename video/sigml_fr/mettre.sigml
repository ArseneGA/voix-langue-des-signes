<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="put1">
  <sign_manual>
    <handconfig handshape="ceeall" mainbend="bent"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="chest"/>
    <tgt_motion>
      <changeposture/>
      <handconfig handshape="pinchall" mainbend="bent"/>
      <handconfig extfidir="o"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
