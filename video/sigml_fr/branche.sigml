<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="branch1">
  <sign_manual>
    <sign_manual>
      <split_handconfig>
        <handconfig handshape="cee12open"/>
        <handconfig handshape="finger2345" thumbpos="out"/>
      </split_handconfig>
      <split_handconfig>
        <handconfig extfidir="ol" palmor="l"/>
        <handconfig extfidir="u" palmor="ur"/>
      </split_handconfig>
      <handconstellation contact="touch">
        <location_hand digits="5" location="midjoint"/>
        <location_hand digits="1" location="nail" side="palmar"/>
        <location_bodyarm location="shouldertop" side="left_at"/>
      </handconstellation>
      <par_motion>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="pinch12open"/>
        </tgt_motion>
        <directedmotion direction="ur" size="small"/>
      </par_motion>
    </sign_manual>
    <sign_manual>
      <split_handconfig>
        <handconfig handshape="cee12open"/>
        <handconfig handshape="finger2345" thumbpos="out"/>
      </split_handconfig>
      <split_handconfig>
        <handconfig extfidir="ol" palmor="l"/>
        <handconfig extfidir="u" palmor="ur"/>
      </split_handconfig>
      <handconstellation contact="touch">
        <location_hand digits="4" location="midjoint"/>
        <location_hand digits="1" location="nail" side="palmar"/>
        <location_bodyarm location="shouldertop" side="left_at"/>
      </handconstellation>
      <par_motion>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="pinch12open"/>
        </tgt_motion>
        <directedmotion direction="ur" size="small"/>
      </par_motion>
    </sign_manual>
    <sign_manual>
      <split_handconfig>
        <handconfig handshape="cee12open"/>
        <handconfig handshape="finger2345" thumbpos="out"/>
      </split_handconfig>
      <split_handconfig>
        <handconfig extfidir="ol" palmor="l"/>
        <handconfig extfidir="u" palmor="ur"/>
      </split_handconfig>
      <handconstellation contact="touch">
        <location_hand digits="3" location="midjoint"/>
        <location_hand digits="1" location="nail" side="palmar"/>
        <location_bodyarm location="shouldertop" side="left_at"/>
      </handconstellation>
      <par_motion>
        <tgt_motion>
          <changeposture/>
          <handconfig handshape="pinch12open"/>
        </tgt_motion>
        <directedmotion direction="u" size="small"/>
      </par_motion>
    </sign_manual>
  </sign_manual>
</hamgestural_sign>

</sigml>
