<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="kilometre1">
  <sign_manual>
    <handconfig bend1="round" bend3="bent" handshape="finger23"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="shouldertop" side="right_at"/>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="o" fast="true" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
