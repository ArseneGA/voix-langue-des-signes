<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="pity1">
  <sign_manual>
    <handconfig bend3="bent" handshape="finger2345"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="shoulders"/>
    <directedmotion direction="i"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
