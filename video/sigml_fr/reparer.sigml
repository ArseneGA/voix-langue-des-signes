<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="repair1">
  <sign_manual>
    <handconfig handshape="finger23" thumbpos="across"/>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="d"/>
      <handconfig extfidir="or" palmor="d"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="touch" digits="2" location="nail">
        <location_hand digits="2" location="nail" side="palmar"/>
      </location_hand>
      <location_bodyarm location="chest" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="i" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
