<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="height1">
  <sign_manual>
    <handconfig handshape="pinch12open" mainbend="bent"/>
    <split_handconfig>
      <handconfig extfidir="u" palmor="dl"/>
      <handconfig extfidir="u" palmor="dr"/>
    </split_handconfig>
    <location_hand contact="touch" digits="1" location="tip"/>
    <directedmotion direction="u" size="big"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
