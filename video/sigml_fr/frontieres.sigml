<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="border1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2" thumbpos="across"/>
      <handconfig handshape="finger23spread" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="u"/>
      <handconfig extfidir="u" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="head" side="right_at"/>
      <location_bodyarm location="shoulders" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2" thumbpos="across"/>
        <handconfig extfidir="l" palmor="l"/>
        <handconstellation contact="touch">
          <location_hand location="midjoint" side="right_beside"/>
          <location_hand location="midjoint"/>
        </handconstellation>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
