<hamgestural_sign gloss="woman1">
  <sign_manual>
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="touch" location="eyebrows" side="right_beside"/>
    <directedmotion direction="do"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
