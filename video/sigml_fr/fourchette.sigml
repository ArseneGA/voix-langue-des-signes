<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="fork1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger23spread" thumbpos="across"/>
      <handconfig handshape="finger2345" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="dl" palmor="d" second_extfidir="o"/>
      <handconfig extfidir="o" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="chest" side="right_at"/>
      <location_bodyarm location="stomach"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <directedmotion direction="dl"/>
        <handconstellation contact="touch">
          <location_hand location="palm"/>
          <location_hand digits="2" location="tip"/>
        </handconstellation>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
