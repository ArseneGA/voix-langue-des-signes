<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="whether1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="close" location="shouldertop" side="right_at"/>
    <tgt_motion>
      <changeposture/>
      <handconfig handshape="finger2" specialfingers="5" thumbpos="across"/>
      <handconfig palmor="dl"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
