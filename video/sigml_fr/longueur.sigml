<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="length1">
  <sign_manual>
    <handconfig handshape="fist" thumbpos="out"/>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="dl"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand digits="1" location="nail" side="palmar"/>
      <location_hand digits="1" location="nail" side="palmar"/>
      <location_bodyarm location="shouldertop"/>
    </handconstellation>
    <directedmotion direction="o" tense="true"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
