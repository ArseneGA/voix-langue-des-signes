<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="enemy1">
  <sign_manual both_hands="true" lr_symm="true">
    <split_handconfig>
      <handconfig handshape="finger2" thumbpos="across"/>
      <handconfig handshape="finger2" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ul" palmor="l"/>
      <handconfig extfidir="ur" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shoulders" side="right_beside"/>
      <location_bodyarm location="shoulders"/>
    </split_location>
    <par_motion>
      <directedmotion direction="d" fast="true"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="l"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
