<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="appreciate1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="chest"/>
    <rpt_motion repetition="fromstart_several">
      <circularmotion axis="l" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
