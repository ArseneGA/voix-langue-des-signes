<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="mood1">
  <sign_manual>
    <handconfig handshape="finger23spread"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="d"/>
    <location_bodyarm contact="close" location="forehead" side="right_at"/>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <directedmotion direction="dl"/>
        <location_bodyarm contact="touch" location="forehead" side="right_at"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
