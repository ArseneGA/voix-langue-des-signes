<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="neighbourhood1">
  <sign_manual>
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="chest"/>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="u"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
