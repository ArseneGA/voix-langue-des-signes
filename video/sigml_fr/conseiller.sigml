<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="advise1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="pinchall" mainbend="bent"/>
      <handconfig handshape="ceeall"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="uo" palmor="dl"/>
      <handconfig extfidir="r" palmor="d"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shoulders"/>
      <location_bodyarm location="chest" second_location="stomach"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="ol" palmor="d"/>
        <location_hand contact="touch" location="wristback">
          <location_hand digits="3" location="tip"/>
        </location_hand>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
