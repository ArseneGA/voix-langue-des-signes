<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="gun1">
  <sign_manual>
    <handconfig handshape="finger23" thumbpos="out"/>
    <handconfig extfidir="ol"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="shoulders" side="right_at"/>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion fast="true">
        <changeposture/>
        <handconfig bend1="hooked" handshape="finger23" thumbpos="out"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
