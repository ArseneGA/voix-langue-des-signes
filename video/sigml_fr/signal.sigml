<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="signal1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="pinch12"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="u"/>
      <handconfig extfidir="r" palmor="dr"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand location="thumbside"/>
      <location_hand location="handback"/>
      <location_bodyarm location="shoulders" second_location="shoulders" side="right_at"/>
    </handconstellation>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <changeposture/>
        <handconfig handshape="finger2345" second_handshape="flat" second_thumbpos="opposed" thumbpos="opposed"/>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
