<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="sauce1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="out"/>
      <handconfig handshape="flat" mainbend="round" second_handshape="flat" second_thumbpos="opposed" thumbpos="opposed"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="ol" palmor="dr"/>
      <handconfig extfidir="or" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shoulders" second_location="shouldertop" second_side="right_at"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <circularmotion axis="d" size="small" start="u"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
