<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="relation1">
  <sign_manual both_hands="true">
    <handconfig handshape="pinch12open"/>
    <split_handconfig>
      <handconfig extfidir="u" palmor="l"/>
      <handconfig extfidir="o" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_hand contact="touch" digits="2" location="nail" side="palmar">
        <location_hand digits="2" location="nail" side="palmar"/>
      </location_hand>
      <location_bodyarm contact="close" location="shoulders"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="o" rest="true"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
