<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="buy1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="finger2" mainbend="hooked"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="dol" palmor="l"/>
      <handconfig extfidir="or" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="chest"/>
      <location_bodyarm location="stomach"/>
    </split_location>
    <tgt_motion>
      <directedmotion direction="d"/>
      <handconstellation contact="touch">
        <location_hand location="palm"/>
        <location_hand digits="2" location="midjoint"/>
      </handconstellation>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
