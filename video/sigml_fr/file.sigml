<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="line1">
  <sign_manual both_hands="true" lr_symm="true" oi_symm="true">
    <handconfig handshape="finger2345" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_hand contact="touch" digits="2" location="tip">
        <location_hand digits="5" location="tip"/>
      </location_hand>
      <location_bodyarm location="shoulders"/>
    </split_location>
    <directedmotion direction="i" size="small"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
