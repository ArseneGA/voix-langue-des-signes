<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="true1">
  <sign_manual>
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="dl"/>
    <location_bodyarm location="chest" second_location="shoulders" second_side="right_at"/>
    <par_motion>
      <directedmotion direction="d" size="small"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="ol" palmor="d"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
