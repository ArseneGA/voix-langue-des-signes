<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="nail1">
  <sign_manual>
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="shouldertop"/>
    <tgt_motion>
      <changeposture/>
      <handconfig handshape="finger2" mainbend="hooked" thumbpos="across"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
