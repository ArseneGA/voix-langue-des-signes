<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="gift1">
  <sign_manual>
    <sign_manual>
      <handconfig handshape="finger2" thumbpos="across"/>
      <split_handconfig>
        <handconfig extfidir="ul" palmor="d"/>
        <handconfig extfidir="or" palmor="d"/>
      </split_handconfig>
      <split_location>
        <location_bodyarm location="shoulders"/>
        <location_bodyarm location="chest" side="left_at"/>
      </split_location>
    </sign_manual>
    <sign_manual>
      <handconfig handshape="finger2" thumbpos="across"/>
      <split_handconfig>
        <handconfig extfidir="ol" palmor="d"/>
        <handconfig extfidir="ur" palmor="d"/>
      </split_handconfig>
      <split_location>
        <location_bodyarm location="chest"/>
        <location_bodyarm location="shoulders" side="left_at"/>
      </split_location>
    </sign_manual>
    <sign_manual>
      <handconfig handshape="finger2" thumbpos="across"/>
      <split_handconfig>
        <handconfig extfidir="ul" palmor="d"/>
        <handconfig extfidir="or" palmor="d"/>
      </split_handconfig>
      <split_location>
        <location_bodyarm location="shoulders"/>
        <location_bodyarm location="chest" side="left_at"/>
      </split_location>
    </sign_manual>
  </sign_manual>
</hamgestural_sign>

</sigml>
