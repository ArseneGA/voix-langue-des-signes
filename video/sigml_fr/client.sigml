<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="customer1">
  <sign_manual>
    <handconfig handshape="finger2" mainbend="hooked" second_handshape="finger2"/>
    <handconfig extfidir="ui"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="close" location="chin">
      <location_hand digits="2" location="tip"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart_several">
      <tgt_motion>
        <directedmotion direction="ui" fast="true"/>
        <location_bodyarm contact="touch" location="chin">
          <location_hand digits="2" location="tip"/>
        </location_bodyarm>
      </tgt_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
