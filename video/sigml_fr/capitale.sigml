<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="capital1">
  <sign_manual both_hands="true">
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="out"/>
      <handconfig handshape="flat" thumbpos="out"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="l" palmor="l"/>
      <handconfig extfidir="r" palmor="d"/>
    </split_handconfig>
    <location_hand contact="touch" location="palm">
      <location_hand digits="1" location="tip"/>
    </location_hand>
    <directedmotion direction="u" size="big"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
