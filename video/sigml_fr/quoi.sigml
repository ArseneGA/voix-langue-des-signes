<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="what1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="ul" second_palmor="u"/>
    <location_bodyarm location="chest"/>
    <rpt_motion repetition="fromstart_several" repetition_incrdecr="decreasing">
      <directedmotion direction="l" fast="true" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
