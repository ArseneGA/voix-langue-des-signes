<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="book1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="flat"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="ul"/>
    <handconstellation contact="touch"/>
    <rpt_motion repetition="fromstart">
      <tgt_motion>
        <changeposture/>
        <handconfig palmor="l"/>
      </tgt_motion>
    </rpt_motion>
    <tgt_motion>
      <changeposture/>
      <handconfig palmor="ul"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
