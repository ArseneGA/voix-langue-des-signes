<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="tea1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="pinch12open"/>
      <handconfig handshape="ceeall"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="o" palmor="d"/>
      <handconfig extfidir="r" palmor="r"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm location="shouldertop"/>
      <location_bodyarm location="chest"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <directedmotion direction="d" size="small" slow="true"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
