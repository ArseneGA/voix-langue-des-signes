<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="closed1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" mainbend="hooked"/>
    <handconfig extfidir="or"/>
    <handconfig palmor="ul"/>
    <par_motion>
      <directedmotion curve="u" direction="l"/>
      <tgt_motion>
        <changeposture/>
        <handconfig extfidir="o" palmor="d"/>
        <location_hand contact="touch" digits="1" location="tip"/>
      </tgt_motion>
    </par_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
