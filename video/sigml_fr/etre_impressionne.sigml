<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="be_impressed1">
  <sign_manual>
    <handconfig handshape="pinchall"/>
    <handconfig extfidir="ul"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="touch" location="chin"/>
    <tgt_motion>
      <changeposture/>
      <handconfig handshape="flat" thumbpos="opposed"/>
      <handconfig extfidir="l" palmor="ul"/>
      <location_bodyarm contact="close" location="underchin"/>
    </tgt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
