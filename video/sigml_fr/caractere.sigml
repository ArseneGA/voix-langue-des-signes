<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="character1">
  <sign_manual>
    <handconfig handshape="finger2" mainbend="round"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="u"/>
    <location_bodyarm contact="touch" location="forehead" side="right_at"/>
    <rpt_motion repetition="fromstart">
      <wristmotion motion="swinging"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
