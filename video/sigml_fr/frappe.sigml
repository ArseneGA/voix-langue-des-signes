<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="strike1">
  <sign_manual>
    <split_handconfig>
      <handconfig handshape="fist" thumbpos="across"/>
      <handconfig handshape="fist" thumbpos="across"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="uo" palmor="u"/>
      <handconfig extfidir="uo" palmor="u"/>
    </split_handconfig>
    <split_location>
      <location_bodyarm contact="close" location="shoulders" side="right_at"/>
      <location_bodyarm contact="close" location="shoulders" side="left_at"/>
    </split_location>
    <rpt_motion repetition="fromstart_several">
      <circularmotion axis="o" size="small"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
