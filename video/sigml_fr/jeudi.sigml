<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="Thursday1">
  <sign_manual>
    <handconfig bend2="dblhooked" bend3="dblhooked" bend4="dblhooked" handshape="flat" thumbpos="out"/>
    <handconfig extfidir="u"/>
    <handconfig palmor="d"/>
    <location_bodyarm location="shoulders" side="right_at"/>
    <tgt_motion>
      <changeposture/>
      <handconfig extfidir="l" palmor="l"/>
    </tgt_motion>
    <wristmotion motion="nodding" size="big"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
