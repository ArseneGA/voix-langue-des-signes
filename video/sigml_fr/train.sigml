<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="train1">
  <sign_manual>
    <handconfig handshape="finger23spread" thumbpos="across"/>
    <handconfig extfidir="o"/>
    <handconfig palmor="l"/>
    <location_bodyarm contact="close" location="stomach" side="right_at"/>
    <circularmotion axis="l" clockplus="true"/>
  </sign_manual>
</hamgestural_sign>

</sigml>
