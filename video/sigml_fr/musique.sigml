<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="music1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="finger2" thumbpos="across"/>
    <handconfig extfidir="ur"/>
    <handconfig palmor="l"/>
    <split_location>
      <location_bodyarm location="shouldertop" side="right_beside"/>
      <location_bodyarm location="shouldertop" side="left_beside"/>
    </split_location>
    <rpt_motion repetition="fromstart">
      <seq_motion>
        <par_motion>
          <directedmotion curve="r" direction="l"/>
          <tgt_motion>
            <changeposture/>
            <handconfig extfidir="ul" palmor="l"/>
          </tgt_motion>
        </par_motion>
        <par_motion>
          <directedmotion curve="r" direction="r"/>
          <tgt_motion>
            <changeposture/>
            <handconfig extfidir="ur" palmor="l"/>
          </tgt_motion>
        </par_motion>
      </seq_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
