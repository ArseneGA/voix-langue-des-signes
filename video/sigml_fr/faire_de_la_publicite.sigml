<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="advertise1">
  <sign_manual both_hands="true" lr_symm="true">
    <handconfig handshape="fist" mainbend="bent" thumbpos="across"/>
    <split_handconfig>
      <handconfig extfidir="ol"/>
      <handconfig extfidir="or"/>
    </split_handconfig>
    <handconfig palmor="u"/>
    <rpt_motion repetition="fromstart_several">
      <circularmotion axis="o"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
