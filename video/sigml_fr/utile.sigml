<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="useful1">
  <sign_manual>
    <handconfig bend3="bent" handshape="finger2345" thumbpos="out"/>
    <handconfig extfidir="l"/>
    <handconfig palmor="dl"/>
    <location_bodyarm contact="touch" location="chest" second_location="chest" second_side="left_at">
      <location_hand digits="3" location="tip"/>
    </location_bodyarm>
    <rpt_motion repetition="fromstart">
      <par_motion>
        <directedmotion curve="d" direction="u" size="small"/>
        <tgt_motion>
          <changeposture/>
          <handconfig palmor="ul"/>
        </tgt_motion>
      </par_motion>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
