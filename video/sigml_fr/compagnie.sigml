<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sigml SYSTEM "http://www.visicast.cmp.uea.ac.uk/sigml/sigml.dtd">
<sigml>

<hamgestural_sign gloss="company1">
  <sign_manual both_hands="true">
    <split_handconfig>
      <handconfig handshape="pinch12open"/>
      <handconfig handshape="pinch12open"/>
    </split_handconfig>
    <split_handconfig>
      <handconfig extfidir="u" palmor="l"/>
      <handconfig extfidir="o" palmor="r"/>
    </split_handconfig>
    <handconstellation contact="touch">
      <location_hand digits="1" location="nail" side="palmar"/>
      <location_hand digits="2" location="nail" side="palmar"/>
      <location_bodyarm location="shoulders"/>
    </handconstellation>
    <rpt_motion repetition="fromstart_several">
      <circularmotion axis="u" fast="true" size="small" start="l"/>
    </rpt_motion>
  </sign_manual>
</hamgestural_sign>

</sigml>
